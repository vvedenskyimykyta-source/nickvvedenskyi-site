---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import { getLocale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  noHeader?: boolean;
  noFooter?: boolean;
}

const { title, description, noHeader, noFooter } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const altLocale = locale === 'en' ? 'uk' : 'en';
const altPath = locale === 'en' ? '/uk/' : '/';
const canonicalUrl = new URL(Astro.url.pathname, 'https://nickvvedenskyi.com');
---

<!doctype html>
<html lang={locale === 'uk' ? 'uk' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl.href} />
    <link rel="alternate" hreflang={altLocale} href={new URL(altPath, 'https://nickvvedenskyi.com').href} />
    <link rel="alternate" hreflang="x-default" href="https://nickvvedenskyi.com/" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- OG -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={locale === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {!noHeader && <Header />}
    <main class="pt-16">
      <slot />
    </main>
    {!noFooter && <Footer />}
    <StickyMobileCTA />
  </body>
</html>
