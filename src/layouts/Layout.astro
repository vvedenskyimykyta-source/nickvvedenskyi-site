---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import Analytics from '../components/Analytics.astro';
import { getLocale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  noHeader?: boolean;
  noFooter?: boolean;
}

const { title, description, noHeader, noFooter } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const altLocale = locale === 'en' ? 'uk' : 'en';
const altPath = locale === 'en' ? '/uk/' : '/';
const canonicalUrl = new URL(Astro.url.pathname, 'https://nickvvedenskyi.com');
---

<!doctype html>
<html lang={locale === 'uk' ? 'uk' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl.href} />
    <link rel="alternate" hreflang={altLocale} href={new URL(altPath, 'https://nickvvedenskyi.com').href} />
    <link rel="alternate" hreflang="x-default" href="https://nickvvedenskyi.com/" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- OG -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={locale === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'uk' ? 'en_US' : 'uk_UA'} />
    <meta property="og:site_name" content="Nick Vvedenskyi" />
    <meta property="og:image" content={`https://nickvvedenskyi.com/og-${locale === 'uk' ? 'uk' : 'en'}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === 'uk' ? 'Nick Vvedenskyi — Revenue & Marketing для Tech/AI продуктів' : 'Nick Vvedenskyi — Revenue & Marketing for Tech/AI Products'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`https://nickvvedenskyi.com/og-${locale === 'uk' ? 'uk' : 'en'}.png`} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Nick Vvedenskyi',
      jobTitle: 'Revenue & Marketing Consultant for Tech/AI Products',
      url: 'https://nickvvedenskyi.com',
      sameAs: [
        'https://www.linkedin.com/in/nick-vvedenskyi/',
        'https://www.instagram.com/lagerfeeld_/'
      ]
    })} />
  </head>
  <body>
    {!noHeader && <Header />}
    <main class="pt-16">
      <slot />
    </main>
    {!noFooter && <Footer />}
    <StickyMobileCTA />
    <Analytics />

    <script>
      // Magnetic button effect — desktop only
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const RADIUS = 80;
        const MAX_SHIFT = 4;
        document.querySelectorAll<HTMLElement>('.btn-magnetic').forEach(btn => {
          btn.addEventListener('mousemove', (e) => {
            const rect = btn.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const dx = e.clientX - cx;
            const dy = e.clientY - cy;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < RADIUS) {
              const strength = 1 - dist / RADIUS;
              btn.style.transform = `translate(${dx * strength * MAX_SHIFT / RADIUS}px, ${dy * strength * MAX_SHIFT / RADIUS}px)`;
            }
          });
          btn.addEventListener('mouseleave', () => {
            btn.style.transform = '';
          });
        });
      }
    </script>
  </body>
</html>
