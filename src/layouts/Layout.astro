---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import Analytics from '../components/Analytics.astro';
import { getLocale } from '../i18n';
import { faq } from '../data/faq';

interface Props {
  title: string;
  description?: string;
  noHeader?: boolean;
  noFooter?: boolean;
  noindex?: boolean;
  showFaqSchema?: boolean;
}

const { title, description, noHeader, noFooter, noindex, showFaqSchema } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const altLocale = locale === 'en' ? 'uk' : 'en';
const altPath = locale === 'en' ? '/uk/' : '/';
const canonicalUrl = new URL(Astro.url.pathname, 'https://www.nickvvedenskyi.com');

const jsonLdGraph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': 'https://www.nickvvedenskyi.com/#person',
    name: 'Nick Vvedenskyi',
    alternateName: 'Mykyta Vvedenskyi',
    jobTitle: 'Revenue & Marketing Consultant',
    description: 'I help tech and AI founders figure out who buys, why they stay and where the money is hiding.',
    url: 'https://www.nickvvedenskyi.com',
    image: 'https://www.nickvvedenskyi.com/images/nick-portrait.jpg',
    sameAs: [
      'https://www.linkedin.com/in/nick-vvedenskyi/',
      'https://www.instagram.com/lagerfeeld_/'
    ],
    knowsLanguage: ['en', 'uk'],
    workLocation: {
      '@type': 'Place',
      name: 'Spain'
    }
  },
  {
    '@type': 'ProfessionalService',
    '@id': 'https://www.nickvvedenskyi.com/#business',
    name: 'Nick Vvedenskyi · Revenue & Marketing',
    description: 'Revenue and marketing consulting for tech and AI products. Customer discovery, positioning, retention, go-to-market and monetization.',
    url: 'https://www.nickvvedenskyi.com',
    founder: { '@id': 'https://www.nickvvedenskyi.com/#person' },
    areaServed: ['Europe', 'United States'],
    serviceType: 'Marketing Consulting',
    priceRange: '€1,000 - €7,000',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Consulting Services',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            '@id': 'https://www.nickvvedenskyi.com/#buyer-sprint',
            name: 'Buyer Sprint',
            description: 'Customer discovery through 10-12 interviews. You get ICP cards, buyer language map, top segments, and clear next steps.',
            provider: { '@id': 'https://www.nickvvedenskyi.com/#person' },
            serviceType: 'Customer Discovery'
          },
          price: '1500',
          priceCurrency: 'EUR',
          priceSpecification: {
            '@type': 'PriceSpecification',
            price: '1500',
            priceCurrency: 'EUR',
            valueAddedTaxIncluded: true,
            description: 'Starting from. Fixed price agreed before work begins.'
          }
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            '@id': 'https://www.nickvvedenskyi.com/#brand-market-fit',
            name: 'Brand-Market Fit',
            description: 'Positioning and messaging so people understand why they should pick you. You get positioning, messaging matrix, elevator pitch, brand guidelines lite.',
            provider: { '@id': 'https://www.nickvvedenskyi.com/#person' },
            serviceType: 'Brand Positioning'
          },
          price: '1500',
          priceCurrency: 'EUR'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            '@id': 'https://www.nickvvedenskyi.com/#pipeline-audit',
            name: 'Pipeline Audit',
            description: 'Funnel and sales process audit. Lost deal analysis and prioritized list of fixes.',
            provider: { '@id': 'https://www.nickvvedenskyi.com/#person' },
            serviceType: 'Sales Audit'
          },
          price: '2000',
          priceCurrency: 'EUR'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            '@id': 'https://www.nickvvedenskyi.com/#grow-through-customers',
            name: 'Grow Through Your Customers',
            description: 'Retention and expansion. Churn interviews, retention playbook, customer health signals, expansion map.',
            provider: { '@id': 'https://www.nickvvedenskyi.com/#person' },
            serviceType: 'Customer Retention Consulting'
          },
          price: '3000',
          priceCurrency: 'EUR'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            '@id': 'https://www.nickvvedenskyi.com/#revenue-unlock',
            name: 'Revenue Unlock',
            description: 'Pricing, packaging, upsells and monetization review. Revenue structure review, pricing recommendations, quick wins, test plan.',
            provider: { '@id': 'https://www.nickvvedenskyi.com/#person' },
            serviceType: 'Revenue Optimization'
          },
          price: '2000',
          priceCurrency: 'EUR'
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            '@id': 'https://www.nickvvedenskyi.com/#launch-sprint',
            name: 'Launch Sprint',
            description: 'Full go-to-market: research, interviews, ICP, messaging, channel plan with CAC math, launch and experiments map.',
            provider: { '@id': 'https://www.nickvvedenskyi.com/#person' },
            serviceType: 'Go-to-Market Strategy'
          },
          price: '7000',
          priceCurrency: 'EUR'
        }
      ]
    }
  }
];

if (showFaqSchema) {
  jsonLdGraph.push({
    '@type': 'FAQPage',
    '@id': 'https://www.nickvvedenskyi.com/#faq',
    mainEntity: faq.map(item => ({
      '@type': 'Question',
      name: item.q[locale],
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a[locale]
      }
    }))
  });
}
---

<!doctype html>
<html lang={locale === 'uk' ? 'uk' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content="Nick Vvedenskyi" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl.href} />
    <link rel="alternate" hreflang={altLocale} href={new URL(altPath, 'https://www.nickvvedenskyi.com').href} />
    <link rel="alternate" hreflang="x-default" href="https://www.nickvvedenskyi.com/" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- OG -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={locale === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'uk' ? 'en_US' : 'uk_UA'} />
    <meta property="og:site_name" content="Nick Vvedenskyi" />
    <meta property="og:image" content={`https://www.nickvvedenskyi.com/og-${locale === 'uk' ? 'uk' : 'en'}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === 'uk' ? 'Nick Vvedenskyi — Revenue & Marketing для Tech/AI продуктів' : 'Nick Vvedenskyi — Revenue & Marketing for Tech/AI Products'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`https://www.nickvvedenskyi.com/og-${locale === 'uk' ? 'uk' : 'en'}.png`} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': jsonLdGraph
    })} />
  </head>
  <body>
    {!noHeader && <Header />}
    <main class="pt-16">
      <slot />
    </main>
    {!noFooter && <Footer />}
    <StickyMobileCTA />
    <Analytics />

    <script>
      // Magnetic button effect — desktop only
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const RADIUS = 80;
        const MAX_SHIFT = 4;
        document.querySelectorAll<HTMLElement>('.btn-magnetic').forEach(btn => {
          btn.addEventListener('mousemove', (e) => {
            const rect = btn.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const dx = e.clientX - cx;
            const dy = e.clientY - cy;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < RADIUS) {
              const strength = 1 - dist / RADIUS;
              btn.style.transform = `translate(${dx * strength * MAX_SHIFT / RADIUS}px, ${dy * strength * MAX_SHIFT / RADIUS}px)`;
            }
          });
          btn.addEventListener('mouseleave', () => {
            btn.style.transform = '';
          });
        });
      }
    </script>
  </body>
</html>
