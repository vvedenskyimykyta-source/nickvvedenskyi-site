---
interface Props {
  id?: string;
  class?: string;
  as?: 'h1' | 'h2' | 'h3';
}

const { id, class: className = '', as: Tag = 'h2' } = Astro.props;
---

<Tag
  id={id}
  class:list={[
    'font-display font-semibold text-ink tracking-tight',
    Tag === 'h1'
      ? 'text-[clamp(2.5rem,6vw,4rem)] leading-[1.05] font-bold'
      : 'text-[clamp(1.75rem,4vw,2.5rem)] leading-[1.15] tracking-[-0.015em]',
    className,
  ]}
>
  <slot />
</Tag>
