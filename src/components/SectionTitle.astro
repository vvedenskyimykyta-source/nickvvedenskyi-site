---
interface Props {
  id?: string;
  class?: string;
  as?: 'h1' | 'h2' | 'h3';
}

const { id, class: className = '', as: Tag = 'h2' } = Astro.props;
---

<Tag
  id={id}
  class:list={[
    'font-display font-semibold text-ink',
    Tag === 'h1'
      ? 'text-[clamp(2.5rem,6vw,4.75rem)] leading-[1.05]'
      : 'text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.1]',
    className,
  ]}
>
  <slot />
</Tag>
