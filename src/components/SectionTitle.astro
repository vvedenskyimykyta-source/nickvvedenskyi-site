---
interface Props {
  class?: string;
  as?: 'h1' | 'h2' | 'h3';
}

const { class: className = '', as: Tag = 'h2' } = Astro.props;
---

<Tag
  class:list={[
    'font-display font-semibold text-ink',
    Tag === 'h1'
      ? 'text-[clamp(2.125rem,5vw,3.75rem)] leading-[1.1]'
      : 'text-[clamp(1.75rem,4vw,2.75rem)] leading-[1.15]',
    className,
  ]}
>
  <slot />
</Tag>
