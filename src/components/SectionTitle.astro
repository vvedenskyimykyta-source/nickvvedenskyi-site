---
interface Props {
  id?: string;
  class?: string;
  as?: 'h1' | 'h2' | 'h3';
}

const { id, class: className = '', as: Tag = 'h2' } = Astro.props;
---

<Tag
  id={id}
  class:list={[
    'font-display font-bold',
    Tag === 'h1'
      ? 'text-[clamp(2.5rem,6vw,4rem)] leading-[1.05] tracking-[-0.07em]'
      : 'text-[clamp(2rem,4vw,3rem)] leading-[1.15] tracking-[-0.04em]',
    className,
  ]}
>
  <slot />
</Tag>
