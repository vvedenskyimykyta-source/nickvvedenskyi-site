---
interface Props {
  class?: string;
  rotate?: number;
  withArrow?: 'left' | 'right' | 'up' | 'down' | 'none';
}

const { class: className = '', rotate = -3, withArrow = 'none' } = Astro.props;

const arrowSvgs = {
  left: '<svg class="inline-block w-6 h-6 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M5 12l6-6M5 12l6 6"/></svg>',
  right: '<svg class="inline-block w-6 h-6 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
  up: '<svg class="inline-block w-6 h-6 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 19V5M6 11l6-6 6 6"/></svg>',
  down: '<svg class="inline-block w-6 h-6 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>',
  none: '',
};
---

<p
  class:list={[
    'font-hand text-wine text-xl md:text-2xl leading-snug max-w-md',
    className,
  ]}
  style={`transform: rotate(${rotate}deg);`}
>
  {withArrow !== 'none' && ['left', 'up', 'down'].includes(withArrow) && (
    <Fragment set:html={arrowSvgs[withArrow]} />
  )}
  <slot />
  {withArrow === 'right' && (
    <Fragment set:html={arrowSvgs.right} />
  )}
</p>
