---
import { t, getLocale } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const langHref = t(locale, 'langSwitchHref');
const langLabel = t(locale, 'langSwitchLabel');
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 h-16 transition-shadow duration-200"
  data-header
>
  <div class="mx-auto flex h-full max-w-[1240px] items-center justify-between px-4 md:px-8">
    <!-- Logo -->
    <a href={locale === 'uk' ? '/uk/' : '/'} class="font-display text-lg font-bold text-dark whitespace-nowrap touch-manipulation">
      Nick Vvedenskyi
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main navigation">
      {[
        { href: '#how-i-help', label: locale === 'en' ? 'How I help' : 'Чим допомагаю' },
        { href: '#cases', label: locale === 'en' ? 'Cases' : 'Кейси' },
        { href: '#about', label: locale === 'en' ? 'About' : 'Про мене' },
        { href: '#faq', label: 'FAQ' },
      ].map(item => (
        <a
          href={item.href}
          class="text-sm font-medium text-text-secondary transition-colors hover:text-dark touch-manipulation"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <!-- Lang switcher -->
      <a
        href={langHref}
        class="text-sm font-bold text-green hover:text-green-hover transition-colors touch-manipulation min-w-[44px] min-h-[44px] flex items-center justify-center"
        aria-label={langLabel === 'UA' ? 'Перейти на українську' : 'Switch to English'}
        data-event="lang_switch"
        data-location="header"
      >
        {langLabel}
      </a>

      <!-- CTA button (desktop) -->
      <a
        href="#book"
        class="hidden lg:inline-flex btn-primary text-sm px-5 py-2"
        data-event="cta_book_call"
        data-location="header"
      >
        {t(locale, 'bookCallShort')}
      </a>

      <!-- Burger button (mobile) -->
      <button
        id="burger-btn"
        class="flex items-center justify-center w-11 h-11 lg:hidden touch-manipulation"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="burger-icon h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="close-icon hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden flex-col bg-white pt-20 px-4 pb-8"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <nav class="flex flex-col gap-2" aria-label="Mobile navigation">
    {[
      { href: '#how-i-help', label: locale === 'en' ? 'How I help' : 'Чим допомагаю' },
      { href: '#cases', label: locale === 'en' ? 'Cases' : 'Кейси' },
      { href: '#about', label: locale === 'en' ? 'About' : 'Про мене' },
      { href: '#faq', label: 'FAQ' },
    ].map(item => (
      <a
        href={item.href}
        class="mobile-nav-link block rounded-2xl px-4 py-3 text-lg font-medium text-dark transition-colors hover:bg-bg touch-manipulation"
      >
        {item.label}
      </a>
    ))}
    <div class="mt-4 pt-4 border-t border-dark/5">
      <a
        href="#book"
        class="mobile-nav-link btn-primary w-full text-center text-base py-3"
        data-event="cta_book_call"
        data-location="header_mobile"
      >
        {t(locale, 'bookCall')}
      </a>
    </div>
  </nav>
</div>

<style>
  [data-header] {
    background: transparent;
  }
  [data-header].scrolled {
    background: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(26, 32, 54, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const burger = document.getElementById('burger-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const burgerIcon = burger.querySelector('.burger-icon')!;
  const closeIcon = burger.querySelector('.close-icon')!;

  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  function toggleMenu(open?: boolean) {
    const isOpen = open ?? menu.classList.contains('hidden');
    menu.classList.toggle('hidden', !isOpen);
    menu.classList.toggle('flex', isOpen);
    burger.setAttribute('aria-expanded', String(isOpen));
    burgerIcon.classList.toggle('hidden', isOpen);
    closeIcon.classList.toggle('hidden', !isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  burger.addEventListener('click', () => toggleMenu());

  menu.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => toggleMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
      toggleMenu(false);
      burger.focus();
    }
  });
</script>
