---
import { t, getLocale } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const langHref = t(locale, 'langSwitchHref');
---

<header
  id="site-header"
  class="sticky top-0 left-0 right-0 z-50 transition-all duration-200"
  data-header
>
  <div class="mx-auto flex max-w-[1240px] items-center gap-6 px-4 py-[14px] md:px-8">
    <!-- Logo -->
    <a
      href={locale === 'uk' ? '/uk/' : '/'}
      class="flex items-center gap-2.5 font-display text-[18px] font-bold whitespace-nowrap touch-manipulation"
      style="letter-spacing:-0.02em;color:#1A1A2E"
    >
      <span>Nick Vvedenskyi</span>
    </a>

    <!-- Desktop nav -->
    <nav class="ml-auto hidden items-center gap-7 text-[15px] font-medium lg:flex" aria-label="Main navigation">
      {[
        { href: '#how-i-help', label: locale === 'en' ? 'How I help' : 'Чим допомагаю' },
        { href: '#cases', label: locale === 'en' ? 'Cases' : 'Кейси' },
        { href: '#about', label: locale === 'en' ? 'About' : 'Про мене' },
      ].map(item => (
        <a href={item.href} class="nav-link touch-manipulation" style="color:#454545">
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Social icons (desktop) -->
    <div class="hidden items-center gap-1 pl-5 lg:flex" style="border-left:1px solid rgba(26,26,46,.1)">
      <a href="https://www.linkedin.com/in/nick-vvedenskyi/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="9" width="4" height="13" rx="1"/><circle cx="4" cy="4.5" r="2.2"/><path d="M9 9h3.8v1.9c.6-1.1 2-2.2 4.1-2.2 4 0 4.6 2.6 4.6 6V22h-4v-6.3c0-1.6 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3V22H9z"/></svg>
      </a>
      <a href="mailto:vvedenskyimykyta@gmail.com" class="social-icon" aria-label="Email">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
      </a>
      <a href="https://www.instagram.com/lagerfeeld_/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
    </div>

    <!-- Lang switcher -->
    <div class="lang-switch ml-auto flex items-center lg:ml-0">
      <a href="/" class:list={['lang-opt', locale === 'en' ? 'is-active' : '']} aria-label="English" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
      <a href="/uk/" lang="uk" class:list={['lang-opt', locale === 'uk' ? 'is-active' : '']} aria-label="Українська" aria-current={locale === 'uk' ? 'page' : undefined}>UA</a>
    </div>

    <!-- Burger button (mobile) -->
    <button
      id="burger-btn"
      class="flex items-center justify-center w-11 h-11 lg:hidden touch-manipulation"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="burger-icon h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg class="close-icon hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
    </button>
  </div>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden flex-col bg-white pt-20 px-4 pb-8"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <nav class="flex flex-col gap-2" aria-label="Mobile navigation">
    {[
      { href: '#how-i-help', label: locale === 'en' ? 'How I help' : 'Чим допомагаю' },
      { href: '#cases', label: locale === 'en' ? 'Cases' : 'Кейси' },
      { href: '#about', label: locale === 'en' ? 'About' : 'Про мене' },
    ].map(item => (
      <a
        href={item.href}
        class="mobile-nav-link block rounded-2xl px-4 py-3 text-lg font-medium text-dark transition-colors hover:bg-bg touch-manipulation"
      >
        {item.label}
      </a>
    ))}
    <div class="mt-4 pt-4 border-t border-dark/5 flex flex-col gap-3">
      <a
        href="#book"
        class="mobile-nav-link btn-primary w-full text-center text-base py-3"
        data-event="cta_book_call"
        data-location="header_mobile"
      >
        {t(locale, 'bookCall')}
      </a>
      <!-- Mobile socials -->
      <div class="flex items-center justify-center gap-4 pt-2">
        <a href="https://www.linkedin.com/in/nick-vvedenskyi/" target="_blank" rel="noopener noreferrer" class="text-text-secondary" aria-label="LinkedIn">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="mailto:vvedenskyimykyta@gmail.com" class="text-text-secondary" aria-label="Email">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
        <a href="https://www.instagram.com/lagerfeeld_/" target="_blank" rel="noopener noreferrer" class="text-text-secondary" aria-label="Instagram">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>
  </nav>
</div>

<style>
  [data-header] {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(26, 26, 46, 0.06);
  }

  .nav-link {
    transition: color 0.15s;
  }
  .nav-link:hover {
    color: #4E8F0F;
  }

  .social-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    color: #1A1A2E;
    transition: background 0.15s, color 0.15s;
  }
  .social-icon:hover {
    background: #F4F4F4;
    color: #4E8F0F;
  }

  .lang-switch {
    padding: 3px;
    border-radius: 999px;
    background: #F4F4F4;
    border: 1px solid rgba(26, 26, 46, 0.06);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .lang-opt {
    padding: 7px 12px;
    border-radius: 999px;
    color: #454545;
    transition: background 0.15s, color 0.15s;
  }
  .lang-opt:hover {
    color: #1A1A2E;
    background: #FFFFFF;
  }
  .lang-opt.is-active {
    background: #1A2036;
    color: #FFFFFF;
    box-shadow: 0 4px 10px -4px rgba(26, 32, 54, 0.5);
  }
  .lang-opt.is-active:hover {
    color: #FFFFFF;
    background: #1A2036;
  }
</style>

<script>
  const burger = document.getElementById('burger-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const burgerIcon = burger.querySelector('.burger-icon')!;
  const closeIcon = burger.querySelector('.close-icon')!;

  function toggleMenu(open?: boolean) {
    const isOpen = open ?? menu.classList.contains('hidden');
    menu.classList.toggle('hidden', !isOpen);
    menu.classList.toggle('flex', isOpen);
    burger.setAttribute('aria-expanded', String(isOpen));
    burgerIcon.classList.toggle('hidden', isOpen);
    closeIcon.classList.toggle('hidden', !isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  burger.addEventListener('click', () => toggleMenu());

  menu.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => toggleMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
      toggleMenu(false);
      burger.focus();
    }
  });
</script>
