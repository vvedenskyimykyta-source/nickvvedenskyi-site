---
import { t, getLocale } from '../../i18n';
import { projects } from '../../data/projects';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
const INITIAL_LIMIT = 21;

function seededRandom(seed: number) {
  const x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
}
---

<section id="projects" class="relative py-[60px] md:py-[100px] bg-dark text-white" style="scroll-margin-top: 5rem;">
  <div class="mx-auto max-w-[1240px] px-4 md:px-8">
    <div class="flex items-end gap-4 mb-2">
      <span class="font-display text-[clamp(4rem,10vw,7rem)] font-bold leading-none tracking-[-0.03em]" style="background: linear-gradient(135deg, #B1F171, #99D4FF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
        {projects.length}
      </span>
    </div>
    <SectionTitle id="projects-heading" class="text-white">{t(locale, 'projectsTitle')}</SectionTitle>
    <p class="mt-3 text-sm text-white/60">{t(locale, 'projectsSub')}</p>

    <Reveal class="mt-10">
      <div id="projects-cloud" class="flex flex-wrap justify-center gap-3 md:gap-4">
        {projects.map((p, i) => {
          const rotation = (seededRandom(i * 37 + 7) * 6 - 3).toFixed(1);
          const isExtra = i >= INITIAL_LIMIT;
          return (
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`project-sticker inline-flex items-center rounded-full bg-white/5 border border-white/10 px-4 py-2 font-display text-sm md:text-base font-medium text-white touch-manipulation min-h-[44px] ${isExtra ? 'projects-extra' : ''}`}
              style={`--sticker-rot: ${rotation}deg;`}
              data-event="outbound_project"
              data-name={p.name}
              data-rotation={rotation}
            >
              {p.name}
              <span class="project-arrow ml-1.5 opacity-0 transition-opacity duration-200">↗</span>
            </a>
          );
        })}
      </div>
      {projects.length > INITIAL_LIMIT && (
        <div class="mt-6 text-center" id="projects-toggle-wrap">
          <button
            id="projects-toggle"
            class="text-sm font-medium text-green-light hover:text-green transition-colors touch-manipulation min-h-[44px] px-4"
            data-event="projects_show_all"
          >
            {t(locale, 'projectsShowAll')}
          </button>
        </div>
      )}
    </Reveal>
  </div>
</section>

<style>
  .project-sticker {
    opacity: 0;
    transform: translateY(8px) rotate(var(--sticker-rot, 0deg));
    transition: opacity 300ms ease, transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 200ms, box-shadow 200ms;
  }
  .project-sticker.sticker-in {
    opacity: 1;
    transform: rotate(var(--sticker-rot, 0deg));
  }
  .project-sticker:hover {
    transform: rotate(0deg) translateY(-2px) !important;
    border-color: var(--color-green-light) !important;
    box-shadow: 0 4px 12px rgba(110, 195, 25, 0.15);
  }
  .project-sticker:hover .project-arrow {
    opacity: 1;
  }

  @media (hover: none) {
    .project-sticker .project-arrow {
      opacity: 1;
    }
    .project-sticker.sticker-in {
      transform: rotate(0deg) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-sticker {
      opacity: 1;
      transform: rotate(var(--sticker-rot, 0deg));
      transition: border-color 200ms, box-shadow 200ms;
    }
  }

  .projects-extra {
    display: none;
  }
  .projects-expanded .projects-extra {
    display: inline-flex;
  }
</style>

<script>
  const stickers = document.querySelectorAll<HTMLElement>('.project-sticker');
  if (stickers.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const container = entry.target;
        container.querySelectorAll<HTMLElement>('.project-sticker:not(.projects-extra)').forEach((s, i) => {
          setTimeout(() => s.classList.add('sticker-in'), i * 40);
        });
        obs.unobserve(container);
      });
    }, { threshold: 0.1 });
    const cloud = document.getElementById('projects-cloud');
    if (cloud) obs.observe(cloud);
  } else {
    stickers.forEach(s => s.classList.add('sticker-in'));
  }

  const toggle = document.getElementById('projects-toggle');
  const cloud = document.getElementById('projects-cloud');
  const wrap = document.getElementById('projects-toggle-wrap');
  if (toggle && cloud) {
    let expanded = false;
    toggle.addEventListener('click', () => {
      expanded = !expanded;
      if (expanded) {
        cloud.classList.add('projects-expanded');
        const extras = cloud.querySelectorAll<HTMLElement>('.projects-extra');
        extras.forEach((s, i) => {
          setTimeout(() => s.classList.add('sticker-in'), i * 40);
        });
        toggle.textContent = toggle.dataset.lessText || 'Show less';
      } else {
        cloud.classList.remove('projects-expanded');
        toggle.textContent = toggle.dataset.moreText || 'Show all';
      }
    });
    toggle.dataset.moreText = toggle.textContent || '';
    toggle.dataset.lessText = document.documentElement.lang === 'uk' ? 'Показати менше' : 'Show less';
  }
</script>
