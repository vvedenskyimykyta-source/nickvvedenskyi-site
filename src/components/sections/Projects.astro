---
import { t, getLocale } from '../../i18n';
import { projects } from '../../data/projects';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
const MOBILE_LIMIT = 10;

function seededRandom(seed: number) {
  const x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
}
---

<Section id="projects">
  <SectionTitle>{t(locale, 'projectsTitle')}</SectionTitle>
  <p class="mt-3 text-sm text-ink-soft">{t(locale, 'projectsSub')}</p>

  {projects.length > 0 ? (
    <Reveal class="mt-10">
      <div id="projects-cloud" class="flex flex-wrap justify-center gap-3 md:gap-4">
        {projects.map((p, i) => {
          const rotation = (seededRandom(i * 37 + 7) * 6 - 3).toFixed(1);
          const borderColor = i % 2 === 0 ? 'border-cobalt' : 'border-wine';
          const hiddenOnMobile = i >= MOBILE_LIMIT ? 'projects-extra' : '';
          return (
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`project-sticker inline-flex items-center rounded-full bg-paper border ${borderColor} px-4 py-2 font-display text-sm md:text-base font-medium text-ink touch-manipulation min-h-[44px] ${hiddenOnMobile}`}
              style={`--sticker-rot: ${rotation}deg;`}
              data-event="outbound_project"
              data-name={p.name}
              data-rotation={rotation}
            >
              {p.name}
              <span class="project-arrow ml-1.5 opacity-0 transition-opacity duration-200">↗</span>
            </a>
          );
        })}
      </div>
      {projects.length > MOBILE_LIMIT && (
        <div class="mt-4 text-center md:hidden" id="projects-toggle-wrap">
          <button
            id="projects-toggle"
            class="text-sm font-medium text-cobalt hover:text-cobalt-dk transition-colors touch-manipulation min-h-[44px] px-4"
            data-event="projects_show_all"
          >
            {locale === 'en' ? `Show all ${projects.length}` : `Показати всі ${projects.length}`}
          </button>
        </div>
      )}
    </Reveal>
  ) : (
    <Reveal class="mt-10">
      <p class="text-ink-soft text-center">
        {locale === 'en' ? 'Coming soon.' : 'Скоро з\'явиться.'}
      </p>
    </Reveal>
  )}
</Section>

<style>
  .project-sticker {
    opacity: 0;
    transform: translateY(8px) rotate(var(--sticker-rot, 0deg));
    transition: opacity 300ms ease, transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 200ms, box-shadow 200ms;
  }
  .project-sticker.sticker-in {
    opacity: 1;
    transform: rotate(var(--sticker-rot, 0deg));
  }
  .project-sticker:hover {
    transform: rotate(0deg) translateY(-2px) !important;
    border-color: var(--color-cobalt) !important;
    box-shadow: 0 4px 8px rgba(47, 79, 168, 0.12);
  }
  .project-sticker:hover .project-arrow {
    opacity: 1;
  }

  @media (hover: none) {
    .project-sticker .project-arrow {
      opacity: 1;
    }
    .project-sticker.sticker-in {
      transform: rotate(0deg) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-sticker {
      opacity: 1;
      transform: rotate(var(--sticker-rot, 0deg));
      transition: border-color 200ms, box-shadow 200ms;
    }
  }

  @media (max-width: 767px) {
    .projects-extra {
      display: none;
    }
    .projects-expanded .projects-extra {
      display: inline-flex;
    }
  }
</style>

<script>
  // Sticker drop-in animation
  const stickers = document.querySelectorAll<HTMLElement>('.project-sticker');
  if (stickers.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const container = entry.target;
        container.querySelectorAll<HTMLElement>('.project-sticker').forEach((s, i) => {
          setTimeout(() => s.classList.add('sticker-in'), i * 40);
        });
        obs.unobserve(container);
      });
    }, { threshold: 0.1 });
    const cloud = document.getElementById('projects-cloud');
    if (cloud) obs.observe(cloud);
  } else {
    stickers.forEach(s => s.classList.add('sticker-in'));
  }

  const toggle = document.getElementById('projects-toggle');
  const cloud = document.getElementById('projects-cloud');
  const wrap = document.getElementById('projects-toggle-wrap');
  if (toggle && cloud) {
    toggle.addEventListener('click', () => {
      cloud.classList.add('projects-expanded');
      const extras = cloud.querySelectorAll<HTMLElement>('.projects-extra');
      extras.forEach((s, i) => {
        setTimeout(() => s.classList.add('sticker-in'), i * 40);
      });
      if (wrap) wrap.style.display = 'none';
    });
  }
</script>
