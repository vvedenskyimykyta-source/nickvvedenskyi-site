---
import { t, getLocale } from '../../i18n';
import SectionTitle from '../SectionTitle.astro';
import HandwrittenNote from '../HandwrittenNote.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
const calLink = `${import.meta.env.PUBLIC_CAL_LINK || 'nick-vvedenskyi'}/intro-call`;
const calUrl = `https://cal.com/${calLink}`;
const tallyUrl = `https://tally.so/r/${locale === 'en' ? import.meta.env.PUBLIC_TALLY_FORM_EN : import.meta.env.PUBLIC_TALLY_FORM_UK}`;
---

<section
  id="book"
  aria-labelledby="book-heading"
  class="relative bg-dark text-white overflow-hidden"
  style="scroll-margin-top: 0;"
>
  <div class="relative mx-auto max-w-[1240px] px-4 md:px-8 pt-20 pb-16 md:pt-28 md:pb-20">
    <Reveal>
      <HandwrittenNote rotate={-3} class="mb-6 !text-white/70 text-lg md:text-xl">
        {t(locale, 'ctaNote')}
      </HandwrittenNote>
    </Reveal>

    <SectionTitle id="book-heading" class="text-white">{t(locale, 'ctaTitle')}</SectionTitle>
    <p class="mt-2 text-lg text-white/60">{t(locale, 'ctaSub')}</p>
    <p class="mt-4 text-white/70 leading-relaxed max-w-[50ch]">
      {t(locale, 'ctaText')}
    </p>

    <!-- Two options layout -->
    <div class="mt-10 grid gap-6 lg:grid-cols-2 lg:gap-8">
      <!-- Card A: Talk to me -->
      <Reveal>
        <div class="rounded-3xl bg-white/5 border border-white/10 h-full flex flex-col p-6 md:p-8 justify-between">
          <div>
            <h3 class="font-display text-2xl md:text-3xl font-bold leading-tight text-white">
              {t(locale, 'ctaCardATitle')}
            </h3>
            <p class="mt-4 text-white/60 leading-relaxed">
              {t(locale, 'ctaCardAText')}
            </p>
          </div>
          <div class="mt-8">
            <a
              href={calUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group block w-full rounded-full bg-green text-white font-display font-bold text-lg py-4 px-6 text-center transition-all duration-300 hover:bg-green-hover hover:shadow-lg hover:-translate-y-0.5 active:scale-[0.98] touch-manipulation"
              data-event="cta_book_call"
              data-location="final"
            >
              <span class="flex items-center justify-center gap-2">
                {t(locale, 'ctaPickTime')}
              </span>
            </a>
          </div>
        </div>
      </Reveal>

      <!-- Card B: Quiz -->
      <Reveal delay={100}>
        <div class="rounded-3xl bg-white/5 border border-white/10 h-full flex flex-col p-6 md:p-8 justify-between">
          <div>
            <h3 class="font-display text-2xl md:text-3xl font-bold leading-tight text-white">
              {t(locale, 'ctaCardBTitle')}
            </h3>
            <p class="mt-4 text-white/60 leading-relaxed">
              {t(locale, 'ctaCardBText')}
            </p>
          </div>
          <div class="mt-8">
            <a
              href={tallyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group block w-full rounded-full border-2 border-green text-green font-display font-bold text-lg py-4 px-6 text-center transition-all duration-300 hover:bg-green hover:text-white hover:shadow-lg hover:-translate-y-0.5 active:scale-[0.98] touch-manipulation"
              data-event="cta_quiz_open"
              data-location="final"
            >
              <span class="flex items-center justify-center gap-2">
                {t(locale, 'ctaCardBButton')}
              </span>
            </a>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
