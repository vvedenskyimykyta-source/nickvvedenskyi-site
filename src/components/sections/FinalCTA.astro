---
import { Image } from 'astro:assets';
import { t, getLocale } from '../../i18n';
import heroImg from '../../assets/images/nick-hero.jpg';

const locale = getLocale(Astro.currentLocale);
const calLink = `${import.meta.env.PUBLIC_CAL_LINK || 'nick-vvedenskyi'}/intro-call`;
const calUrl = `https://cal.com/${calLink}`;
const tallyUrl = `https://tally.so/r/${locale === 'en' ? import.meta.env.PUBLIC_TALLY_FORM_EN : import.meta.env.PUBLIC_TALLY_FORM_UK}`;
---

<section
  id="book"
  aria-labelledby="book-heading"
  class="relative py-24 md:py-28 overflow-hidden"
  style="scroll-margin-top: 0;"
>
  <div class="relative mx-auto max-w-[1240px] px-4 md:px-8">
    <p class="font-hand text-[22px] text-text-secondary mb-4" style="transform: rotate(-2deg); transform-origin: left;">
      {t(locale, 'ctaNote')}
    </p>

    <p class="font-mono text-xs uppercase tracking-[0.15em] text-text-secondary mb-3">{t(locale, 'ctaLabel')}</p>
    <h2 id="book-heading" class="font-display text-[clamp(2rem,4vw,2.5rem)] font-bold text-dark tracking-[-0.035em]">{t(locale, 'ctaTitle')}</h2>
    <p class="mt-4 text-text-secondary leading-relaxed max-w-[50ch]">
      {t(locale, 'ctaText')}
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr_auto] lg:gap-8 items-stretch">
      <!-- Card A: Let's talk (green) -->
      <div class="rounded-[28px] bg-green p-8 flex flex-col justify-between" style="box-shadow: 0 10px 24px -10px rgba(110,195,25,0.4);">
        <div>
          <h3 class="font-display text-2xl md:text-3xl font-bold text-dark">{t(locale, 'ctaCardATitle')}</h3>
          <p class="mt-3 text-dark/70 leading-relaxed">{t(locale, 'ctaCardAText')}</p>
        </div>
        <a
          href={calUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center justify-center gap-2 w-full rounded-full bg-dark text-white font-display font-bold text-lg py-4 px-6 text-center transition-all duration-300 hover:bg-dark/90 hover:shadow-lg hover:-translate-y-0.5"
          data-event="cta_book_call"
          data-location="final"
        >
          {t(locale, 'ctaPickTime')}
        </a>
      </div>

      <!-- Card B: Free advice (light) -->
      <div class="rounded-[28px] bg-bg border border-dark/[0.06] p-8 flex flex-col justify-between">
        <div>
          <h3 class="font-display text-2xl md:text-3xl font-bold text-dark">{t(locale, 'ctaCardBTitle')}</h3>
          <p class="mt-3 text-text-secondary leading-relaxed">{t(locale, 'ctaCardBText')}</p>
        </div>
        <a
          href={tallyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary mt-8 w-full text-center justify-center"
          data-event="cta_quiz_open"
          data-location="final"
        >
          {t(locale, 'ctaCardBButton')}
        </a>
      </div>

      <!-- Photo -->
      <div class="hidden lg:block w-[200px] rounded-[28px] overflow-hidden" style="aspect-ratio: 3/4;">
        <Image
          src={heroImg}
          alt="Nick Vvedenskyi"
          widths={[200, 400]}
          sizes="200px"
          class="w-full h-full object-cover object-top"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
