---
import { Image } from 'astro:assets';
import { t, getLocale } from '../../i18n';
import Reveal from '../Reveal.astro';
import ctaImg from '../../assets/images/nick-cta.jpg';

const locale = getLocale(Astro.currentLocale);
const calLink = `${import.meta.env.PUBLIC_CAL_LINK || 'nick-vvedenskyi'}/intro-call`;
const calUrl = `https://cal.com/${calLink}`;
const tallyUrl = `https://tally.so/r/${locale === 'en' ? import.meta.env.PUBLIC_TALLY_FORM_EN : import.meta.env.PUBLIC_TALLY_FORM_UK}`;
---

<section id="book" class="cta" aria-labelledby="book-heading">
  <div class="cta-glow" aria-hidden="true"></div>

  <div class="cta-row">
    <div class="cta-aside">
      <Reveal>
        <div class="cta-photo">
          <Image
            src={ctaImg}
            alt={t(locale, 'altCta')}
            widths={[420, 840]}
            sizes="(max-width: 520px) 100vw, 420px"
            class="cta-photo-img"
            loading="lazy"
          />
        </div>
        <div class="font-hand cta-note">{t(locale, 'ctaNote')}</div>
      </Reveal>
    </div>

    <div class="cta-main">
      <Reveal>
        <div class="font-mono cta-kicker">{t(locale, 'ctaLabel')}</div>
        <h2 id="book-heading" class="font-display cta-title">{t(locale, 'ctaTitle')}</h2>
        <p class="cta-text">{t(locale, 'ctaText')}</p>

        <div class="cta-cards">
          <div class="cta-card cta-card-green">
            <span class="cta-icon cta-icon-green">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
            </span>
            <span class="font-display cta-card-title">{t(locale, 'ctaCardATitle')}</span>
            <span class="cta-card-text">{t(locale, 'ctaCardAText')}</span>
            <a
              href={calUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="cta-btn-dark"
              data-event="cta_book_call"
              data-location="final"
            >
              {t(locale, 'ctaPickTime')}
            </a>
          </div>

          <div class="cta-card cta-card-grey">
            <span class="cta-icon cta-icon-white">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13 7l4 4"/></svg>
            </span>
            <span class="font-display cta-card-title">{t(locale, 'ctaCardBTitle')}</span>
            <span class="cta-card-text cta-card-text-muted">{t(locale, 'ctaCardBText')}</span>
            <a
              href={tallyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="cta-btn-light"
              data-event="cta_quiz_open"
              data-location="final"
            >
              {t(locale, 'ctaCardBButton')}
            </a>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .cta {
    scroll-margin-top: 72px;
    padding: 110px 0;
    position: relative;
    overflow: hidden;
    overflow: clip;
  }
  .cta-glow {
    position: absolute;
    width: 900px;
    height: 900px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(204, 233, 255, .8), rgba(204, 233, 255, 0) 65%);
    pointer-events: none;
  }

  .cta-row {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
    justify-content: center;
  }
  .cta-aside {
    position: relative;
    flex: 1 1 300px;
    max-width: 420px;
    min-width: 0;
  }
  .cta-main {
    flex: 2 1 520px;
    min-width: 0;
  }

  .cta-photo {
    aspect-ratio: 4/5;
    border-radius: 32px;
    overflow: hidden;
    background: #CCE9FF;
    box-shadow: 0 30px 60px -30px rgba(26, 32, 54, .45);
  }
  .cta-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }
  .cta-note {
    margin-top: 20px;
    font-size: 28px;
    line-height: 1.2;
    color: #454545;
    transform: rotate(-1.5deg);
    text-align: center;
  }

  .cta-kicker {
    font-size: 13px;
    color: #454545;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .cta-title {
    font-weight: 700;
    font-size: clamp(38px, 4.2vw, 58px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 10px 0 0;
    color: #1A1A2E;
  }
  .cta-text {
    font-size: 17px;
    line-height: 1.55;
    color: #454545;
    margin: 18px 0 0;
    max-width: 600px;
  }

  .cta-cards {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }
  .cta-card {
    border-radius: 24px;
    padding: 28px;
    color: #1A1A2E;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform .25s ease;
  }
  .cta-card:hover {
    transform: translateY(-3px);
  }
  .cta-card-green {
    background: #6EC319;
  }
  .cta-card-grey {
    background: #F4F4F4;
    border: 1px solid rgba(26, 26, 46, .06);
  }

  .cta-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: #1A1A2E;
    display: grid;
    place-items: center;
  }
  .cta-icon-green {
    background: rgba(255, 255, 255, .45);
  }
  .cta-icon-white {
    background: #FFFFFF;
  }

  .cta-card-title {
    font-weight: 700;
    font-size: 26px;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .cta-card-text {
    font-size: 15.5px;
    line-height: 1.55;
    flex: 1;
  }
  .cta-card-text-muted {
    color: #454545;
  }

  .cta-btn-dark {
    align-self: start;
    background: #1A2036;
    color: #FFFFFF;
    padding: 14px 22px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    transition: color .2s ease;
  }
  .cta-btn-dark:hover {
    color: #B1F171;
  }
  .cta-btn-light {
    align-self: start;
    background: #FFFFFF;
    color: #1A1A2E;
    padding: 13px 21px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    border: 1.5px solid rgba(26, 26, 46, .15);
    transition: border-color .2s ease;
  }
  .cta-btn-light:hover {
    border-color: #1A1A2E;
    color: #1A1A2E;
  }

  @media (max-width: 767px) {
    .cta {
      padding: 64px 0;
    }
    .cta-row {
      padding: 0 20px;
      gap: 36px;
    }
  }
</style>
