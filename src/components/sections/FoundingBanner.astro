---
import { t, getLocale } from '../../i18n';
import HandwrittenNote from '../HandwrittenNote.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
---

<aside class="relative bg-green py-12 md:py-16" aria-label={locale === 'en' ? 'Founding client offer' : 'Пропозиція для перших клієнтів'}>
  <div class="mx-auto max-w-[1240px] px-4 md:px-8">
    <Reveal>
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
        <div class="flex-1">
          <span class="inline-block rounded-full bg-white text-green font-display font-bold text-lg px-4 py-1 mb-4">
            {t(locale, 'foundingBadge')}
          </span>
          <h2 class="font-display text-2xl font-bold md:text-3xl text-white">{t(locale, 'foundingTitle')}</h2>
          <p class="mt-4 text-lg text-white/80 leading-relaxed max-w-[58ch]">
            {t(locale, 'foundingText')}
          </p>
          <a
            href="#book"
            class="mt-6 inline-flex text-base px-8 py-3.5 rounded-full bg-white text-green font-display font-bold transition-all duration-300 hover:bg-white/90 hover:shadow-lg"
            data-event="cta_book_call"
            data-location="founding"
          >
            {t(locale, 'foundingButton')}
            <svg class="ml-2 h-4 w-4 arrow-icon transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
        </div>
        <div class="md:text-right">
          <HandwrittenNote rotate={-3} class="text-lg md:text-xl !text-white/80">
            {t(locale, 'foundingNote')}
          </HandwrittenNote>
        </div>
      </div>
    </Reveal>
  </div>
</aside>
