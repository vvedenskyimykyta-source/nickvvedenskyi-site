---
import { t, getLocale } from '../../i18n';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
---

<section class="founding" aria-label={locale === 'en' ? 'Founding client offer' : 'Пропозиція для перших клієнтів'}>
  <div class="founding-inner">
    <Reveal>
      <div class="founding-card">
        <div class="founding-glow-white" aria-hidden="true"></div>
        <div class="founding-glow-green" aria-hidden="true"></div>

        <div class="founding-badge-wrap">
          <span class="founding-dot-dark" aria-hidden="true"></span>
          <span class="founding-dot-white" aria-hidden="true"></span>
          <span class="founding-dot-green" aria-hidden="true"></span>
          <span class="founding-ring" aria-hidden="true"></span>
          <div class="font-display founding-badge">{t(locale, 'foundingBadge')}</div>
        </div>

        <div class="founding-content">
          <div class="font-display founding-title">{t(locale, 'foundingTitle')}</div>

          <div class="founding-row">
            <p class="founding-text">
              <b>{t(locale, 'foundingCondition')}</b>{t(locale, 'foundingText')}
            </p>

            <div class="founding-cta">
              <a href="#book" class="founding-btn" data-event="cta_book_call" data-location="founding">
                <span>{t(locale, 'foundingButton')}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
              </a>
              <span class="font-hand founding-note">{t(locale, 'foundingNote')}</span>
            </div>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .founding {
    padding: 80px 0 0;
  }
  .founding-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .founding-card {
    position: relative;
    /* clip, not hidden: the glows overhang the edges, and `hidden` would leave the
       card programmatically scrollable (scrollIntoView could shift its contents). */
    overflow: hidden;
    overflow: clip;
    border-radius: 16px;
    background: linear-gradient(115deg, #F6B955 0%, #F8C673 55%, #FAD493 100%);
    padding: 56px 52px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 48px;
  }
  .founding-glow-white {
    position: absolute;
    width: 420px;
    height: 420px;
    right: -120px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, .55), rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
  }
  .founding-glow-green {
    position: absolute;
    width: 320px;
    height: 320px;
    left: -120px;
    bottom: -200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(177, 241, 113, .45), rgba(177, 241, 113, 0) 70%);
    pointer-events: none;
  }

  .founding-badge-wrap {
    position: relative;
    flex: 0 0 auto;
    padding: 12px 18px 12px 6px;
  }
  .founding-dot-dark,
  .founding-dot-white,
  .founding-dot-green,
  .founding-ring {
    position: absolute;
    border-radius: 50%;
  }
  .founding-dot-dark {
    left: -6px;
    top: -4px;
    width: 12px;
    height: 12px;
    background: #1A2036;
  }
  .founding-dot-white {
    left: 14px;
    top: -14px;
    width: 7px;
    height: 7px;
    background: #FFFFFF;
  }
  .founding-dot-green {
    right: -2px;
    bottom: -6px;
    width: 9px;
    height: 9px;
    background: #6EC319;
  }
  .founding-ring {
    right: 10px;
    top: -10px;
    width: 18px;
    height: 18px;
    border: 2px solid #1A2036;
  }
  .founding-badge {
    font-weight: 800;
    font-size: 96px;
    line-height: 1;
    letter-spacing: -0.05em;
    color: #1A2036;
    transform: rotate(-3deg);
  }

  .founding-content {
    position: relative;
    flex: 1 1 480px;
    min-width: 0;
  }
  .founding-title {
    font-weight: 700;
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #1A2036;
    text-wrap: balance;
  }
  .founding-row {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 20px 40px;
  }
  .founding-text {
    margin: 0;
    flex: 1 1 360px;
    min-width: 0;
    font-size: 17px;
    line-height: 1.55;
    color: #1A2036;
    max-width: 620px;
    text-wrap: pretty;
  }
  .founding-cta {
    flex: 0 0 auto;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .founding-btn {
    background: #6EC319;
    color: #1A1A2E;
    padding: 17px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 16px;
    box-shadow: 0 10px 24px -10px rgba(26, 26, 46, .5);
    display: flex;
    align-items: center;
    gap: 10px;
    transition: background .2s ease;
  }
  .founding-btn:hover {
    background: #7FD62A;
    color: #1A1A2E;
  }
  .founding-note {
    font-size: 28px;
    line-height: 1.2;
    color: #1A2036;
    transform: rotate(-3deg);
    margin-top: 8px;
  }

  @media (max-width: 767px) {
    .founding-inner { padding: 0 20px; }
    .founding-card { padding: 32px 24px; gap: 24px; }
    .founding-badge { font-size: 68px; }
    .founding-title { font-size: 26px; }
    .founding-row { gap: 20px; }
    /* Stop the button and note from being pushed off the right edge. */
    .founding-cta { margin-left: 0; align-items: flex-start; width: 100%; }
    .founding-note { font-size: 22px; }
  }
</style>
