---
import { t, getLocale } from '../../i18n';
import { cases } from '../../data/cases';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="cases" class="cases" aria-labelledby="cases-heading">
  <div class="cases-inner">
    <Reveal>
      <div class="cases-head">
        <div>
          <div class="font-mono cases-kicker">{t(locale, 'casesTitle')}</div>
          <h2 id="cases-heading" class="font-display cases-title">{t(locale, 'casesSub')}</h2>
        </div>

        <div class="cases-nav">
          <span class="font-mono cases-counter" id="cases-counter">{pad(1)} / {pad(cases.length)}</span>
          <button type="button" id="cases-prev" class="cases-btn cases-btn-prev" aria-label="Previous case">←</button>
          <button type="button" id="cases-next" class="cases-btn cases-btn-next" aria-label="Next case">→</button>
        </div>
      </div>
    </Reveal>
  </div>

  <div class="cases-track" id="cases-track">
    {cases.map((c, i) => (
      <article class="cases-card">
        <div class="cases-card-meta">
          <span class="font-display cases-card-num">{pad(i + 1)}</span>
          <span class="cases-card-tag" style={`background:${c.tagBg}`}>{c.label[locale]}</span>
        </div>

        <h3 class="font-display cases-card-title">{c.title[locale]}</h3>

        <p class="cases-card-story">{c.story[locale]}</p>

        <div class="cases-result">
          <div class="font-mono cases-result-label">{t(locale, 'casesResult')}</div>
          <div class="font-display cases-result-value">{c.result[locale]}</div>
        </div>

        <div class="font-hand cases-lesson">{c.lesson[locale]}</div>
      </article>
    ))}
  </div>

  <div class="cases-inner">
    <div class="cases-bar">
      <div class="cases-bar-fill" id="cases-bar-fill"></div>
    </div>
  </div>
</section>

<style>
  .cases {
    scroll-margin-top: 72px;
    padding: 110px 0 100px;
    overflow: hidden;
    overflow: clip;
  }
  .cases-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .cases-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .cases-kicker {
    font-size: 13px;
    color: #454545;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .cases-title {
    font-weight: 700;
    font-size: clamp(36px, 4vw, 54px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 10px 0 0;
    color: #1A1A2E;
  }

  .cases-nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cases-counter {
    font-size: 14px;
    color: #454545;
    margin-right: 8px;
  }
  .cases-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    font-size: 18px;
    transition: all .2s ease;
  }
  .cases-btn-prev {
    border: 1.5px solid rgba(26, 26, 46, .15);
    background: #FFFFFF;
    color: #1A1A2E;
  }
  .cases-btn-prev:hover {
    border-color: #1A1A2E;
  }
  .cases-btn-next {
    border: none;
    background: #1A2036;
    color: #FFFFFF;
  }
  .cases-btn-next:hover {
    background: #6EC319;
    color: #1A1A2E;
  }
  .cases-btn:disabled {
    opacity: .35;
    cursor: default;
  }

  .cases-track {
    margin-top: 40px;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 8px max(32px, calc((100vw - 1176px) / 2)) 32px;
    scroll-padding: 0 max(32px, calc((100vw - 1176px) / 2));
  }
  .cases-track::-webkit-scrollbar {
    display: none;
  }

  .cases-card {
    flex: 0 0 min(86vw, 440px);
    scroll-snap-align: start;
    background: #FFFFFF;
    border: 1px solid rgba(26, 26, 46, .08);
    border-radius: 28px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 20px 40px -28px rgba(26, 26, 46, .3);
  }
  .cases-card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cases-card-num {
    font-weight: 700;
    font-size: 15px;
    color: #6EC319;
  }
  .cases-card-tag {
    font-size: 13px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
    color: #1A1A2E;
  }
  .cases-card-title {
    margin: 0;
    font-weight: 700;
    font-size: 25px;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
    color: #1A1A2E;
  }
  .cases-card-story {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: #454545;
    flex: 1;
  }

  .cases-result {
    background: #F4F4F4;
    border-radius: 18px;
    padding: 18px 20px;
  }
  .cases-result-label {
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #454545;
    margin-bottom: 6px;
  }
  .cases-result-value {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #1A1A2E;
  }

  .cases-lesson {
    font-size: 22px;
    line-height: 1.15;
    color: #4E8F0F;
  }

  .cases-bar {
    height: 4px;
    border-radius: 4px;
    background: #F4F4F4;
    overflow: hidden;
  }
  .cases-bar-fill {
    height: 100%;
    border-radius: 4px;
    background: #1A2036;
    width: 0;
    margin-left: 0;
    transition: margin-left .15s linear;
  }

  @media (max-width: 767px) {
    .cases { padding: 64px 0; }
    .cases-inner { padding: 0 20px; }
    .cases-title { font-size: 32px; }
    .cases-head { align-items: flex-start; gap: 16px; }
    .cases-track { padding: 8px 20px 24px; scroll-padding: 0 20px; }
    .cases-card-title { font-size: 21px; }
  }
</style>

<script>
  const track = document.getElementById('cases-track');
  const fill = document.getElementById('cases-bar-fill');
  const counter = document.getElementById('cases-counter');
  const prev = document.getElementById('cases-prev') as HTMLButtonElement | null;
  const next = document.getElementById('cases-next') as HTMLButtonElement | null;

  if (track && fill && counter && prev && next) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.cases-card'));
    const pad = (n: number) => String(n).padStart(2, '0');

    const activeIndex = () => {
      // The card whose left edge sits closest to the track's scroll origin.
      let best = 0;
      let min = Infinity;
      cards.forEach((card, i) => {
        const d = Math.abs(card.offsetLeft - track.scrollLeft - track.clientLeft);
        if (d < min) { min = d; best = i; }
      });
      return best;
    };

    const sync = () => {
      const ratio = track.clientWidth / track.scrollWidth;
      fill.style.width = `${ratio * 100}%`;
      fill.style.marginLeft = `${(track.scrollLeft / track.scrollWidth) * 100}%`;

      const i = activeIndex();
      counter.textContent = `${pad(i + 1)} / ${pad(cards.length)}`;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
    };

    const go = (dir: -1 | 1) => {
      const i = activeIndex() + dir;
      const card = cards[Math.max(0, Math.min(cards.length - 1, i))];
      if (card) track.scrollTo({ left: card.offsetLeft - cards[0].offsetLeft, behavior: 'smooth' });
    };

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  }
</script>
