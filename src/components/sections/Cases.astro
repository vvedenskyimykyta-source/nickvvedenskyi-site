---
import { t, getLocale } from '../../i18n';
import { cases } from '../../data/cases';

const locale = getLocale(Astro.currentLocale);
---

<section id="cases" class="relative py-24 md:py-28" style="scroll-margin-top: 5rem;">
  <div class="mx-auto max-w-[1240px] px-4 md:px-8">
    <h2 id="cases-heading" class="font-display text-[clamp(2rem,4vw,2.5rem)] font-bold text-dark tracking-[-0.035em] uppercase">{t(locale, 'casesTitle')}</h2>
    <p class="mt-2 text-lg text-text-secondary">{t(locale, 'casesSub')}</p>
  </div>

  <!-- Horizontal scroll carousel -->
  <div class="mt-10 relative">
    <div class="cases-scroll flex gap-5 overflow-x-auto scroll-smooth px-4 md:px-8 pb-4 snap-x snap-mandatory scrollbar-hide" id="cases-track">
      <div class="shrink-0 w-0 md:w-[calc((100vw-1240px)/2)]" aria-hidden="true"></div>
      {cases.map((c, i) => (
        <article
          class="cases-card shrink-0 w-[85vw] sm:w-[400px] md:w-[420px] snap-start flex flex-col rounded-[28px] bg-white border border-dark/[0.08] p-[30px] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg"
        >
          <span
            class="self-start rounded-full px-3 py-0.5 text-xs font-medium text-dark"
            style={`background: ${c.tagBg}`}
          >
            {c.label[locale]}
          </span>
          <h3 class="mt-3 font-display text-xl font-bold text-dark leading-snug">{c.title[locale]}</h3>
          <p class="mt-3 text-text-secondary leading-relaxed flex-1 text-sm">{c.story[locale]}</p>

          <div class="mt-4 rounded-2xl bg-bg px-4 py-3">
            <p class="font-display text-base font-bold text-green-dark">{c.result[locale]}</p>
          </div>

          <p class="mt-3 font-hand text-sm text-text-secondary" style={`transform: rotate(${i % 2 === 0 ? '-2' : '-3'}deg);`}>
            {c.lesson[locale]}
          </p>
        </article>
      ))}
      <div class="shrink-0 w-4 md:w-[calc((100vw-1240px)/2)]" aria-hidden="true"></div>
    </div>

    <!-- Navigation -->
    <div class="mx-auto max-w-[1240px] px-4 md:px-8 mt-6 flex items-center justify-between">
      <div class="flex gap-1.5" id="cases-dots">
        {cases.map((_, i) => (
          <button
            class={`cases-dot h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-green w-6' : 'bg-dark/10 w-3'}`}
            data-dot={i}
            aria-label={`Case ${i + 1}`}
          />
        ))}
      </div>
      <div class="flex gap-2">
        <button id="cases-prev" class="w-10 h-10 rounded-full bg-bg flex items-center justify-center text-dark hover:bg-dark/10 transition-colors" aria-label="Previous case">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L9.832 10l2.938 3.71a.75.75 0 11-1.04 1.08l-3.5-4.25a.75.75 0 010-1.08l3.5-4.25a.75.75 0 011.06.02z"/></svg>
        </button>
        <button id="cases-next" class="w-10 h-10 rounded-full bg-bg flex items-center justify-center text-dark hover:bg-dark/10 transition-colors" aria-label="Next case">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L10.168 10 7.23 6.29a.75.75 0 111.04-1.08l3.5 4.25a.75.75 0 010 1.08l-3.5 4.25a.75.75 0 01-1.06-.02z"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('cases-track')!;
  const cards = track.querySelectorAll<HTMLElement>('.cases-card');
  const dots = document.querySelectorAll<HTMLElement>('.cases-dot');
  const prevBtn = document.getElementById('cases-prev')!;
  const nextBtn = document.getElementById('cases-next')!;

  function getActiveIndex() {
    const trackRect = track.getBoundingClientRect();
    let closest = 0;
    let minDist = Infinity;
    cards.forEach((card, i) => {
      const cardRect = card.getBoundingClientRect();
      const dist = Math.abs(cardRect.left - trackRect.left - 16);
      if (dist < minDist) { minDist = dist; closest = i; }
    });
    return closest;
  }

  function updateDots(active: number) {
    dots.forEach((d, i) => {
      d.classList.toggle('bg-green', i === active);
      d.classList.toggle('w-6', i === active);
      d.classList.toggle('bg-dark/10', i !== active);
      d.classList.toggle('w-3', i !== active);
    });
  }

  function scrollToCard(index: number) {
    const card = cards[index];
    if (!card) return;
    card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
  }

  prevBtn.addEventListener('click', () => {
    const i = getActiveIndex();
    if (i > 0) scrollToCard(i - 1);
  });
  nextBtn.addEventListener('click', () => {
    const i = getActiveIndex();
    if (i < cards.length - 1) scrollToCard(i + 1);
  });
  dots.forEach(d => {
    d.addEventListener('click', () => {
      const i = Number(d.dataset.dot);
      if (!isNaN(i)) scrollToCard(i);
    });
  });

  track.addEventListener('scroll', () => {
    updateDots(getActiveIndex());
  }, { passive: true });
</script>
