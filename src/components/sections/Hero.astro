---
import { Image } from 'astro:assets';
import { t, getLocale } from '../../i18n';
import HandwrittenNote from '../HandwrittenNote.astro';
import heroImg from '../../assets/images/nick-hero.jpg';

const locale = getLocale(Astro.currentLocale);

const h1 = t(locale, 'heroH1');
const highlightEN = 'on purpose.';
const highlightUK = 'не випадково.';
const highlight = locale === 'en' ? highlightEN : highlightUK;
const idx = h1.lastIndexOf(highlight);
const h1Before = idx >= 0 ? h1.slice(0, idx) : h1;
const h1Accent = idx >= 0 ? highlight : '';
---

<section id="hero" class="relative overflow-hidden bg-paper" style="scroll-margin-top: 5rem;">
  <div class="mx-auto max-w-[1280px] px-6 md:px-6 pt-8 pb-16 md:py-20 lg:py-0 lg:min-h-[100svh] lg:flex lg:items-center">
    <div class="flex flex-col lg:flex-row lg:items-center lg:gap-16 w-full">
      <!-- Photo (top on mobile) -->
      <div class="hero-enter relative flex-shrink-0 lg:order-2 lg:w-[45%]" style="--enter-i: 0;">
        <div class="relative mx-auto max-w-[320px] lg:max-w-none">
          <!-- Decorative green gradient blob -->
          <div class="deco-blob absolute -inset-12 lg:-inset-16 opacity-40" aria-hidden="true"></div>

          <div class="hero-photo relative overflow-hidden rounded-3xl shadow-lg">
            <Image
              src={heroImg}
              alt={locale === 'uk' ? 'Nick Vvedenskyi, консультант з revenue та маркетингу для tech та AI продуктів' : 'Nick Vvedenskyi, revenue and marketing consultant for tech and AI products'}
              widths={[320, 440, 560, 640, 880]}
              sizes="(max-width: 640px) 320px, (max-width: 1024px) 320px, 45vw"
              class="w-full h-auto object-cover object-top max-h-[60svh] lg:max-h-none"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <HandwrittenNote class="mt-4 lg:absolute lg:-bottom-6 lg:-left-12 text-base md:text-xl" rotate={-3} withArrow="up">
            {t(locale, 'heroNote')}
          </HandwrittenNote>
        </div>
      </div>

      <!-- Text -->
      <div class="flex-1 mt-8 lg:mt-0 lg:order-1">
        <!-- Eyebrow with green dot -->
        <div class="hero-enter flex items-center gap-2.5" style="--enter-i: 1;">
          <span class="block w-2 h-2 rounded-full bg-cobalt flex-shrink-0" aria-hidden="true"></span>
          <p class="font-display font-semibold text-sm md:text-base text-cobalt uppercase tracking-wider">
            {t(locale, 'heroEyebrow')}
          </p>
        </div>

        <h1 class="hero-enter mt-5 md:mt-6 font-display font-bold text-ink text-[clamp(2.5rem,6vw,4rem)] leading-[1.05] tracking-[-0.02em] max-w-[18ch]" style="--enter-i: 2;">
          {h1Before}<span class="text-cobalt">{h1Accent}</span>
        </h1>

        <p class="hero-enter mt-6 text-lg md:text-xl text-ink-soft leading-relaxed max-w-[58ch]" style="--enter-i: 3;">
          {t(locale, 'heroSub')}
        </p>

        <div class="hero-enter mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5" style="--enter-i: 4;">
          <a
            href="#book"
            class="btn-primary btn-magnetic justify-center sm:justify-start text-base px-8 py-3.5"
            data-event="cta_book_call"
            data-location="hero"
          >
            {t(locale, 'bookCall')}
            <svg class="ml-2 h-4 w-4 arrow-icon transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a
            href={`https://tally.so/r/${locale === 'en' ? import.meta.env.PUBLIC_TALLY_FORM_EN : import.meta.env.PUBLIC_TALLY_FORM_UK}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary btn-magnetic justify-center sm:justify-start text-sm px-6 py-3"
            data-event="cta_quiz_open"
            data-location="hero"
          >
            {t(locale, 'quizCta')}
            <svg class="ml-1.5 h-4 w-4 arrow-icon transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-enter {
    opacity: 0;
    transform: translateY(12px);
  }
  .hero-enter.entered {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 450ms cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(var(--enter-i, 0) * 80ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  requestAnimationFrame(() => {
    document.querySelectorAll('.hero-enter').forEach(el => el.classList.add('entered'));
  });
</script>
