---
import { Image } from 'astro:assets';
import { t, getLocale } from '../../i18n';
import SectionTitle from '../SectionTitle.astro';
import HandwrittenNote from '../HandwrittenNote.astro';
import Doodles from '../Doodles.astro';
import heroImg from '../../assets/images/nick-hero.jpg';

const locale = getLocale(Astro.currentLocale);
---

<section id="hero" class="relative overflow-hidden" style="scroll-margin-top: 5rem;">
  <div class="mx-auto max-w-7xl px-5 md:px-6 py-8 md:py-16 lg:py-20">
    <div class="flex flex-col-reverse lg:flex-row lg:items-center lg:gap-12">
      <!-- Text -->
      <div class="flex-1 mt-8 lg:mt-0">
        <p class="text-sm font-semibold uppercase tracking-wider text-cobalt">
          {t(locale, 'heroEyebrow')}
        </p>

        <SectionTitle as="h1" class="mt-4 md:mt-6">
          <Fragment set:html={
            t(locale, 'heroH1').replace(
              locale === 'en' ? 'not picking up' : 'не збираєш',
              `<span class="relative inline-block">${locale === 'en' ? 'not picking up' : 'не збираєш'}<svg class="absolute -bottom-1 left-0 w-full h-3" viewBox="0 0 200 12" preserveAspectRatio="none" fill="none"><path d="M2 8 C40 2, 80 10, 120 6 C160 2, 190 8, 198 4" stroke="var(--color-wine)" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg></span>`
            )
          } />
        </SectionTitle>

        <p class="mt-6 text-lg text-ink-soft leading-relaxed max-w-2xl">
          {t(locale, 'heroSub')}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
          <a
            href="#book"
            class="btn-primary justify-center sm:justify-start"
            data-event="cta_book_call"
            data-location="hero"
          >
            {t(locale, 'bookCall')}
            <svg class="ml-2 h-4 w-4 arrow-icon transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a
            href={`https://tally.so/r/${locale === 'en' ? import.meta.env.PUBLIC_TALLY_FORM_EN : import.meta.env.PUBLIC_TALLY_FORM_UK}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary justify-center sm:justify-start"
            data-event="cta_quiz_open"
            data-location="hero"
          >
            {t(locale, 'quizCta')}
          </a>
        </div>
      </div>

      <!-- Photo -->
      <div class="relative flex-shrink-0 lg:w-[380px] xl:w-[420px]">
        <div class="relative mx-auto w-[280px] sm:w-[320px] lg:w-full">
          <div class="overflow-hidden rounded-3xl">
            <Image
              src={heroImg}
              alt="Nick Vvedenskyi"
              widths={[400, 600, 800]}
              sizes="(max-width: 640px) 280px, (max-width: 1024px) 320px, 420px"
              class="w-full h-auto object-cover object-top max-h-[35dvh] sm:max-h-[45dvh] lg:max-h-none"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <!-- Handwritten note with arrow -->
          <HandwrittenNote class="mt-4 lg:absolute lg:-bottom-6 lg:-left-12 text-base md:text-xl" rotate={-3} withArrow="up">
            {t(locale, 'heroNote')}
          </HandwrittenNote>
        </div>
      </div>
    </div>
  </div>
</section>
