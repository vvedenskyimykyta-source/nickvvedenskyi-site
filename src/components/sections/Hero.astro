---
import { Image } from 'astro:assets';
import { t, getLocale } from '../../i18n';
import heroImg from '../../assets/images/nick-hero.jpg';

const locale = getLocale(Astro.currentLocale);

const stats = [
  { value: t(locale, 'stat1Value'), suffix: '', label: t(locale, 'stat1Label') },
  { value: t(locale, 'stat2Value'), suffix: '', label: t(locale, 'stat2Label') },
  { value: t(locale, 'stat3Value'), suffix: '+', label: t(locale, 'stat3Label') },
  { value: t(locale, 'stat4Value'), suffix: '+', label: t(locale, 'stat4Label') },
];
---

<section id="hero" class="relative overflow-hidden bg-white" style="padding:72px 0 40px;scroll-margin-top:5rem">
  <!-- Decorative blobs -->
  <div
    class="pointer-events-none absolute rounded-full"
    style="width:720px;height:720px;right:-160px;top:-260px;background:radial-gradient(circle,#CCE9FF 0%,rgba(204,233,255,0) 68%)"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute rounded-full"
    style="width:560px;height:560px;left:-220px;top:180px;background:radial-gradient(circle,rgba(177,241,113,.55) 0%,rgba(177,241,113,0) 68%)"
    aria-hidden="true"
  ></div>

  <div
    class="relative mx-auto max-w-[1240px] px-8 grid items-center"
    style="grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:56px"
  >
    <!-- Text column -->
    <div class="hero-enter" style="--enter-i:0">
      <div
        class="font-hand inline-block"
        style="font-size:30px;font-weight:600;color:#4E8F0F;transform:rotate(-3deg);transform-origin:left;margin-bottom:18px"
      >
        {t(locale, 'heroEyebrow')}
      </div>

      <h1
        class="font-display"
        style="font-weight:700;font-size:clamp(42px,5.2vw,70px);line-height:1.02;letter-spacing:-0.04em;margin:0;text-wrap:balance;color:#1A1A2E"
      >
        {t(locale, 'heroH1')}<span class="hero-highlight">{t(locale, 'heroH1Accent')}</span>
      </h1>

      <p style="font-size:19px;line-height:1.55;color:#454545;margin:28px 0 0;max-width:560px;text-wrap:pretty">
        {t(locale, 'heroSub')}
      </p>

      <div class="flex flex-wrap" style="gap:12px;margin-top:36px">
        <a href="#book" class="btn-primary" data-event="cta_book_call" data-location="hero">
          <span>{t(locale, 'bookCall')}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
        </a>
        <a
          href={`https://tally.so/r/${locale === 'en' ? import.meta.env.PUBLIC_TALLY_FORM_EN : import.meta.env.PUBLIC_TALLY_FORM_UK}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
          data-event="cta_quiz_open"
          data-location="hero"
        >
          {t(locale, 'quizCta')}
        </a>
      </div>
    </div>

    <!-- Photo column -->
    <div class="hero-enter relative justify-self-center w-full max-w-[470px]" style="--enter-i:1">
      <div
        class="absolute"
        style="inset:24px -24px -24px 24px;border-radius:36px;background:linear-gradient(140deg,#B1F171,#99D4FF)"
        aria-hidden="true"
      ></div>

      <div
        class="relative overflow-hidden"
        style="aspect-ratio:4/5;border-radius:36px;background:#CCE9FF;box-shadow:0 30px 60px -30px rgba(26,32,54,.45)"
      >
        <Image
          src={heroImg}
          alt={t(locale, 'altHero')}
          widths={[470, 700, 940]}
          sizes="(max-width: 520px) 100vw, 470px"
          class="w-full h-full object-cover block"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div
        class="absolute bg-white"
        style="right:-56px;bottom:20px;padding:14px 20px 12px;border-radius:18px;box-shadow:0 18px 40px -18px rgba(26,26,46,.35);transform:rotate(4deg);max-width:320px"
      >
        <div class="font-hand flex flex-col" style="font-size:24px;line-height:1.1;color:#1A1A2E;gap:4px">
          <span>{t(locale, 'heroNote')}</span>
          <span>{t(locale, 'heroNoteSecondary')}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Numbers -->
  <div class="relative mx-auto max-w-[1240px] px-8" style="margin-top:72px">
    <div
      id="hero-stats"
      class="grid bg-white"
      style="border-radius:28px;box-shadow:0 1px 2px rgba(26,26,46,.04),0 24px 48px -24px rgba(26,26,46,.18);border:1px solid rgba(26,26,46,.06);grid-template-columns:repeat(auto-fit,minmax(220px,1fr))"
    >
      {stats.map(s => (
        <div style="padding:32px 32px 30px;border-left:1px solid rgba(26,26,46,.07)">
          <div
            class="font-display"
            style="font-weight:700;font-size:64px;line-height:1;letter-spacing:-0.05em;color:#1A1A2E"
          >
            <span class="stat-num" data-count-to={s.value}>{s.value}</span><span style="color:#6EC319">{s.suffix}</span>
          </div>
          <div style="margin-top:12px;font-size:15px;line-height:1.45;color:#454545;max-width:220px">{s.label}</div>
        </div>
      ))}
    </div>

    <div
      class="font-hand"
      style="font-size:28px;line-height:1.2;color:#454545;margin:26px auto 0;max-width:860px;text-align:center;transform:rotate(-1deg)"
    >
      {t(locale, 'heroQuote')}
    </div>
  </div>
</section>

<style>
  .hero-enter {
    opacity: 0;
    transform: translateY(12px);
  }
  .hero-enter.entered {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 450ms cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 450ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(var(--enter-i, 0) * 80ms);
  }

  /* clip, not hidden: the blobs overhang the edges, and `hidden` would leave the
     section programmatically scrollable (scrollIntoView could shift its contents). */
  #hero {
    overflow: hidden;
    overflow: clip;
  }

  .hero-highlight {
    background: linear-gradient(transparent 60%, #B1F171 60%, #B1F171 92%, transparent 92%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  requestAnimationFrame(() => {
    document.querySelectorAll('.hero-enter').forEach(el => el.classList.add('entered'));
  });

  const statsBar = document.getElementById('hero-stats');
  const nums = statsBar?.querySelectorAll<HTMLElement>('.stat-num');

  if (statsBar && nums?.length) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      nums.forEach(n => (n.textContent = '0'));

      const run = () => {
        const DURATION = 1600;
        nums.forEach(n => {
          const target = Number(n.dataset.countTo);
          if (!Number.isFinite(target)) return;
          const start = performance.now();
          const tick = (now: number) => {
            const p = Math.min((now - start) / DURATION, 1);
            // easeOutExpo
            const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
            n.textContent = String(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      };

      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            io.disconnect();
            run();
          }
        });
      }, { threshold: 0.35 });

      io.observe(statsBar);
    }
  }
</script>
