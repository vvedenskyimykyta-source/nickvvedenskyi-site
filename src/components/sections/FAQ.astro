---
import { t, getLocale } from '../../i18n';
import { faq } from '../../data/faq';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
---

<Section id="faq" narrow ariaLabelledby="faq-heading">
  <SectionTitle id="faq-heading">{t(locale, 'faqTitle')}</SectionTitle>

  <div class="mt-10 divide-y divide-dark/5">
    {faq.map((item, i) => (
      <Reveal delay={i * 60}>
        <details class="group py-5">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-lg font-bold touch-manipulation min-h-[44px] list-none [&::-webkit-details-marker]:hidden">
            <span>{item.q[locale]}</span>
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-bg flex items-center justify-center transition-colors duration-300 group-open:bg-green-light">
              <svg class="h-4 w-4 text-dark transition-transform duration-300 group-open:rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M8 3v10M3 8h10"/>
              </svg>
            </span>
          </summary>
          <div class="faq-answer overflow-hidden">
            <div class="mt-3 rounded-2xl bg-bg p-4">
              <p class="text-text-secondary leading-relaxed pr-4 max-w-[58ch]">{item.a[locale]}</p>
            </div>
          </div>
        </details>
      </Reveal>
    ))}
  </div>
</Section>
