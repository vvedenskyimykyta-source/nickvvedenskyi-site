---
import { t, getLocale } from '../../i18n';
import { howSteps, howFacts } from '../../data/howIWork';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import HandwrittenNote from '../HandwrittenNote.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
---

<Section id="how-i-work" ariaLabelledby="how-i-work-heading">
  <Reveal class="mb-8">
    <HandwrittenNote rotate={-2} class="text-xl md:text-2xl">
      {t(locale, 'howNote')}
    </HandwrittenNote>
  </Reveal>

  <SectionTitle id="how-i-work-heading">{t(locale, 'howTitle')}</SectionTitle>

  <!-- Steps -->
  <div class="mt-10 relative">
    <div class="flex flex-col gap-8 md:grid md:grid-cols-4 md:gap-6">
      {howSteps.map((step, i) => (
        <Reveal delay={i * 100}>
          <div class="relative">
            {/* Dashed connecting line (desktop) */}
            {i < howSteps.length - 1 && (
              <div class="hidden md:block absolute top-6 left-[calc(50%+28px)] right-[-24px] border-t-2 border-dashed border-dark/10" aria-hidden="true" />
            )}
            <div class="card p-5 md:text-center h-full">
              <div class="flex md:justify-center">
                <div
                  class="flex h-12 w-12 items-center justify-center rounded-full font-display text-lg font-bold text-dark-alt"
                  style={`background: ${step.badgeBg}`}
                >
                  {step.num}
                </div>
              </div>
              <h3 class="mt-4 font-display text-lg font-bold">{step.title[locale]}</h3>
              <p class="mt-2 text-text-secondary leading-relaxed text-sm">{step.text[locale]}</p>
            </div>
          </div>
        </Reveal>
      ))}
    </div>
  </div>

  <!-- Facts -->
  <div class="mt-12 grid gap-px bg-dark/5 rounded-2xl overflow-hidden sm:grid-cols-2 lg:grid-cols-4">
    {howFacts.map((fact, i) => (
      <Reveal delay={i * 80}>
        <div class="bg-white p-5 flex items-start gap-3 h-full">
          <div
            class="flex-shrink-0 mt-1 w-3 h-3 rounded-full"
            style={`background: ${fact.dotColor}`}
          />
          <p class="text-sm text-text-secondary leading-relaxed">{fact.text[locale]}</p>
        </div>
      </Reveal>
    ))}
  </div>
</Section>
