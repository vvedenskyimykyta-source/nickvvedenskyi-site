---
import { t, getLocale } from '../../i18n';
import { howSteps, howFacts } from '../../data/howIWork';

const locale = getLocale(Astro.currentLocale);
---

<section id="how-i-work" class="py-24 md:py-28" aria-labelledby="how-i-work-heading">
  <div class="mx-auto max-w-[1240px] px-4 md:px-8">
    <p class="font-hand text-[22px] text-text-secondary mb-4" style="transform: rotate(-2deg); transform-origin: left;">
      {t(locale, 'howNote')}
    </p>

    <h2 id="how-i-work-heading" class="font-display text-[clamp(2rem,4vw,2.5rem)] font-bold text-dark tracking-[-0.035em]">{t(locale, 'howTitle')}</h2>

    <!-- Steps -->
    <div class="mt-10 grid gap-6 md:grid-cols-4">
      {howSteps.map((step, i) => (
        <div class="relative">
          {i < howSteps.length - 1 && (
            <div class="hidden md:block absolute top-6 left-[calc(50%+28px)] right-[-24px] border-t-2 border-dashed border-dark/10" aria-hidden="true" />
          )}
          <div class="rounded-[28px] bg-white border border-dark/[0.06] p-5 md:text-center h-full">
            <div class="flex md:justify-center">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-full font-display text-lg font-bold text-dark"
                style={`background: ${step.badgeBg}`}
              >
                {step.num}
              </div>
            </div>
            <h3 class="mt-4 font-display text-lg font-bold text-dark">{step.title[locale]}</h3>
            <p class="mt-2 text-text-secondary leading-relaxed text-sm">{step.text[locale]}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Facts -->
    <div class="mt-12 grid gap-px bg-dark/[0.05] rounded-2xl overflow-hidden sm:grid-cols-2 lg:grid-cols-4">
      {howFacts.map(fact => (
        <div class="bg-white p-5 flex items-start gap-3 h-full">
          <div
            class="flex-shrink-0 mt-1 w-3 h-3 rounded-full"
            style={`background: ${fact.dotColor}`}
          />
          <p class="text-sm text-text-secondary leading-relaxed">{fact.text[locale]}</p>
        </div>
      ))}
    </div>
  </div>
</section>
