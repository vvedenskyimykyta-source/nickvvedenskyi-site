---
import { t, getLocale } from '../../i18n';
import { problems } from '../../data/problems';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);

const tagColors: Record<string, string> = {
  Discovery: 'border-t-cobalt',
  Positioning: 'border-t-wine',
  GTM: 'border-t-[#B8860B]',
  Sales: 'border-t-[#2E7D6F]',
  Retention: 'border-t-[#8B5CF6]',
};
---

<Section id="problems" ariaLabelledby="problems-heading">
  <SectionTitle id="problems-heading">{t(locale, 'problemsTitle')}</SectionTitle>

  <p class="mt-4 text-lg text-ink-soft leading-relaxed max-w-[58ch]">
    {t(locale, 'problemsIntro')}
  </p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {problems.map((p, i) => {
      const borderClass = tagColors[p.tags[0]] || 'border-t-cobalt';
      return (
        <Reveal delay={i * 80}>
          <div class={`problem-card relative flex h-full flex-col justify-between rounded-2xl border border-line border-t-[3px] ${borderClass} bg-white p-6 transition-all duration-200`}>
            <span class="absolute top-4 left-5 font-display text-5xl font-bold text-ink/[0.04] leading-none select-none" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="flex justify-end gap-1.5 mb-3">
              {p.tags.map(tag => (
                <span class="rounded-full bg-cobalt/10 text-cobalt px-3 py-0.5 text-xs font-medium">{tag}</span>
              ))}
            </div>
            <p class="text-lg font-medium leading-snug text-ink flex-1">
              {p.quote[locale]}
            </p>
          </div>
        </Reveal>
      );
    })}

    {/* Card 6: CTA card */}
    <Reveal delay={problems.length * 80}>
      <div class="problem-card relative flex h-full flex-col justify-between rounded-2xl border-2 border-cobalt bg-cobalt/5 p-6 transition-all duration-200">
        <div class="flex justify-end gap-1.5 mb-3">
          <span class="rounded-full bg-cobalt/10 text-cobalt px-3 py-0.5 text-xs font-medium">{t(locale, 'problemsCtaTag')}</span>
        </div>
        <div class="flex-1 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-xl font-semibold">{t(locale, 'problemsCtaTitle')}</h3>
            <p class="mt-2 text-ink-soft leading-relaxed">{t(locale, 'problemsCtaText')}</p>
          </div>
          <a
            href="#book"
            class="btn-primary mt-4 inline-flex self-start"
            data-event="cta_book_call"
            data-location="problems"
          >
            {t(locale, 'bookCall')}
            <svg class="ml-2 h-4 w-4 arrow-icon transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
        </div>
      </div>
    </Reveal>
  </div>

  <Reveal class="mt-10">
    <p class="text-lg text-ink-soft leading-relaxed max-w-[58ch]">
      {t(locale, 'problemsClosing')}
    </p>
  </Reveal>
</Section>

<style>
  .problem-card:hover {
    border-color: var(--color-cobalt);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(47, 79, 168, 0.1);
  }
</style>
