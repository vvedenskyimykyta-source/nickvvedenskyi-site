---
import { t, getLocale } from '../../i18n';
import { problems } from '../../data/problems';
import { services } from '../../data/services';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);

// Each problem names the pipeline step that answers it; match by name, not position,
// because the two lists are ordered differently.
const stepIndexFor = (ctaEn: string) => services.findIndex(s => s.name === ctaEn);
---

<section id="problems" style="padding:110px 0 100px" aria-labelledby="problems-heading">
  <div class="mx-auto max-w-[1240px] px-8">
    <Reveal>
      <div class="problems-head">
        <h2 id="problems-heading" class="font-display problems-title">
          {t(locale, 'problemsTitle')}
        </h2>
        <p class="problems-intro">{t(locale, 'problemsIntro')}</p>
      </div>
    </Reveal>

    <div class="problems-grid">
      {problems.map((p, i) => (
        <Reveal delay={i * 60}>
          <button type="button" class="problem-card" data-goto-step={stepIndexFor(p.cta.en)}>
            <div class="problem-top">
              <span class="font-mono problem-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="problem-tag">{p.label[locale]}</span>
            </div>

            <p class="font-display problem-text">{p.quote[locale]}</p>

            <div class="problem-foot">
              <span>{p.cta[locale]}</span><span class="problem-arrow">→</span>
            </div>
          </button>
        </Reveal>
      ))}

      <!-- Custom approach CTA card (dark) -->
      <Reveal delay={problems.length * 60}>
        <a href="#book" class="problem-cta" data-event="cta_book_call" data-location="problems">
          <div class="problem-cta-glow" aria-hidden="true"></div>

          <div class="problem-top problem-cta-top">
            <span class="font-mono problem-cta-num">{String(problems.length + 1).padStart(2, '0')}</span>
            <span class="problem-cta-tag">{t(locale, 'problemsCtaTag')}</span>
          </div>

          <div class="problem-cta-body">
            <div class="font-display problem-cta-title">{t(locale, 'problemsCtaTitle')}</div>
            <p class="problem-cta-text">
              {t(locale, 'problemsCtaText')}<br />{t(locale, 'problemsCtaText2')}
            </p>
          </div>

          <div class="problem-cta-foot">
            <span>{t(locale, 'problemsCtaButton')}</span><span class="problem-arrow">→</span>
          </div>
        </a>
      </Reveal>
    </div>

    <Reveal>
      <p class="font-display problems-closing">
        {t(locale, 'problemsClosing')}<span class="problems-closing-accent">{t(locale, 'problemsClosingAccent')}</span>
      </p>
    </Reveal>
  </div>
</section>

<style>
  .problems-head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 48px;
  }
  .problems-title {
    font-weight: 700;
    font-size: clamp(36px, 4vw, 54px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0;
    max-width: 620px;
    color: #1A1A2E;
  }
  .problems-intro {
    font-size: 19px;
    line-height: 1.55;
    color: #454545;
    margin: 0;
    max-width: 640px;
    text-wrap: pretty;
  }

  .problems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }

  .problem-card {
    width: 100%;
    height: 100%;
    text-align: left;
    background: #F4F4F4;
    border: 1px solid transparent;
    border-radius: 24px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 260px;
    color: #1A1A2E;
    transition: all .25s ease;
  }
  .problem-card:hover {
    background: #FFFFFF;
    border-color: rgba(26, 26, 46, .08);
    box-shadow: 0 24px 48px -24px rgba(26, 26, 46, .25);
    transform: translateY(-4px);
  }

  .problem-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .problem-num {
    font-size: 13px;
    color: #454545;
  }
  .problem-tag {
    font-size: 13px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
    background: #FFFFFF;
    color: #4E8F0F;
  }
  .problem-text {
    margin: 0;
    font-size: 21px;
    line-height: 1.35;
    letter-spacing: -0.01em;
    font-weight: 500;
    flex: 1;
    text-wrap: pretty;
  }
  .problem-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #4E8F0F;
    border-top: 1px solid rgba(26, 26, 46, .08);
    padding-top: 16px;
    width: 100%;
  }
  .problem-arrow {
    margin-left: auto;
  }

  .problem-cta {
    width: 100%;
    height: 100%;
    background: #1A2036;
    border-radius: 24px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 260px;
    color: #FFFFFF;
    position: relative;
    overflow: hidden;
    overflow: clip;
    transition: transform .25s ease;
  }
  .problem-cta:hover {
    color: #FFFFFF;
    transform: translateY(-4px);
  }
  .problem-cta-glow {
    position: absolute;
    width: 280px;
    height: 280px;
    right: -90px;
    bottom: -110px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(110, 195, 25, .55), rgba(110, 195, 25, 0) 70%);
    pointer-events: none;
  }
  .problem-cta-top {
    position: relative;
  }
  .problem-cta-num {
    font-size: 13px;
    color: #CCE9FF;
  }
  .problem-cta-tag {
    font-size: 13px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .1);
    color: #FFFFFF;
  }
  .problem-cta-body {
    position: relative;
    flex: 1;
  }
  .problem-cta-title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .problem-cta-text {
    margin: 10px 0 0;
    font-size: 16px;
    line-height: 1.5;
    color: #CCE9FF;
  }
  .problem-cta-foot {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #B1F171;
    border-top: 1px solid rgba(255, 255, 255, .12);
    padding-top: 16px;
  }

  .problems-closing {
    margin: 48px auto 0;
    max-width: 760px;
    text-align: center;
    font-size: 24px;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: #1A1A2E;
    text-wrap: balance;
  }
  .problems-closing-accent {
    color: #4E8F0F;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-goto-step]').forEach(card => {
    card.addEventListener('click', () => {
      const i = Number(card.dataset.gotoStep);
      const section = document.getElementById('how-i-help');
      if (!section) return;
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      document.querySelector<HTMLElement>(`.pipeline-step[data-step-index="${i}"]`)?.click();
    });
  });
</script>
