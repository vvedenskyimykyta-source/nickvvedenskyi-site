---
import { t, getLocale } from '../../i18n';
import { problems } from '../../data/problems';

const locale = getLocale(Astro.currentLocale);
---

<section id="problems" class="py-24 md:py-28" aria-labelledby="problems-heading">
  <div class="mx-auto max-w-[1240px] px-4 md:px-8">
    <h2 id="problems-heading" class="font-display text-[clamp(2rem,4vw,2.5rem)] font-bold text-dark tracking-[-0.035em]">
      {t(locale, 'problemsTitle')}
    </h2>

    <p class="mt-4 text-lg text-text-secondary leading-relaxed max-w-[58ch]">
      {t(locale, 'problemsIntro')}
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {problems.map((p, i) => (
        <button
          class="problem-card text-left bg-bg border border-transparent rounded-3xl p-7 flex flex-col gap-[18px] min-h-[260px] transition-all duration-[250ms] ease-in-out hover:bg-white hover:border-dark/[0.08] hover:shadow-lg hover:-translate-y-1"
          type="button"
          data-problem={i}
        >
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs font-medium text-text-secondary tracking-[0.06em] uppercase">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display text-lg font-semibold text-dark">{p.label[locale]}</span>
          </div>
          <p class="text-[15.5px] text-text-secondary leading-relaxed flex-1">
            {p.quote[locale]}
          </p>
          <span class="inline-flex self-start rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-green-dark">{p.cta[locale]}</span>
        </button>
      ))}

      <!-- Custom approach CTA card (dark) -->
      <a
        href="#book"
        class="group relative overflow-hidden bg-deep rounded-3xl p-7 flex flex-col gap-[18px] min-h-[260px] text-white transition-all duration-[250ms] ease-in-out hover:-translate-y-1"
        data-event="cta_book_call"
        data-location="problems"
      >
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs font-medium text-white/60 tracking-[0.06em] uppercase">{String(problems.length + 1).padStart(2, '0')}</span>
          <span class="font-display text-lg font-semibold">{t(locale, 'problemsCtaTag')}</span>
        </div>
        <div class="flex-1 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-xl font-bold">{t(locale, 'problemsCtaTitle')}</h3>
            <p class="mt-2 text-white/70 leading-relaxed text-[15.5px]">{t(locale, 'problemsCtaText')}</p>
          </div>
          <span class="mt-4 inline-flex self-start items-center gap-2 font-semibold text-green-light group-hover:text-white transition-colors">
            {t(locale, 'problemsCtaButton')}
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </span>
        </div>
      </a>
    </div>

    <p class="mt-10 text-lg text-text-secondary leading-relaxed max-w-[58ch]">
      <span class="font-hand text-[22px] text-text-secondary">{t(locale, 'problemsClosing')}</span>
    </p>
  </div>
</section>
