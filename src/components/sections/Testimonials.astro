---
import { t, getLocale } from '../../i18n';
import { testimonials } from '../../data/testimonials';
import { site } from '../../data/site';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
---

<Section id="testimonials" bg="white" ariaLabelledby="testimonials-heading">
  <SectionTitle id="testimonials-heading">{t(locale, 'testimonialsTitle')}</SectionTitle>
  <p class="mt-3 text-sm text-text-secondary max-w-[58ch]">{t(locale, 'testimonialsSub')}</p>

  <!-- Testimonials scroll container -->
  <div class="mt-10 relative">
    <div
      id="testimonials-scroll"
      class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 scrollbar-hide"
      style="-webkit-overflow-scrolling: touch;"
    >
      {testimonials.map((item, i) => {
        const quote = item.quote[locale] || item.quote.en;
        const initials = item.name
          ? (item.name[locale] || item.name.en).split(' ').map(w => w[0]).join('')
          : (item.role[locale] || item.role.en).split(' ').map(w => w[0]).join('').slice(0, 2);

        return (
          <div class="flex-shrink-0 snap-start w-[85vw] max-w-sm md:w-[380px]">
            <article class="card relative flex h-full flex-col p-6">
              {/* Large green quote mark */}
              <span class="font-display text-[56px] leading-none text-green font-bold select-none" aria-hidden="true">"</span>

              {/* Translated tag */}
              {item.translated && locale === 'en' && (
                <span class="mb-2 inline-flex self-start rounded-full bg-amber/20 text-dark-alt px-3 py-0.5 text-xs font-medium">
                  {t(locale, 'translatedFrom')}
                </span>
              )}

              {/* Quote */}
              <blockquote cite={site.linkedinRecommendations} class="testimonial-quote flex-1">
                <p class="text-text-secondary leading-relaxed line-clamp-6 testimonial-text whitespace-pre-line text-sm">{quote}</p>
                <button class="testimonial-expand mt-2 text-sm font-medium text-green hover:text-green-hover touch-manipulation hidden">
                  {t(locale, 'readMore')}
                </button>
              </blockquote>

              {/* Author */}
              <footer class="mt-4 pt-4 border-t border-dark/5 flex items-center gap-3">
                <div
                  class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-dark-alt shrink-0"
                  style={`background: ${item.avatarBg || '#CCE9FF'}`}
                >
                  {initials}
                </div>
                <div>
                  {item.isPersonal && item.name && (
                    <p class="font-bold text-sm text-dark">{item.name[locale] || item.name.en}</p>
                  )}
                  <p class="text-sm text-text-secondary">{item.role[locale]}</p>
                </div>
              </footer>

              {!item.isPersonal && (
                <a
                  href={site.linkedinRecommendations}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center text-xs font-medium text-green hover:text-green-hover transition-colors touch-manipulation min-h-[44px]"
                  data-event="outbound_linkedin"
                  data-location="testimonials"
                >
                  {t(locale, 'readOnLinkedin')} ↗
                </a>
              )}
            </article>
          </div>
        );
      })}
    </div>

    <!-- Scroll dots -->
    <div id="testimonials-dots" class="mt-6 flex justify-center gap-2" aria-hidden="true">
      {testimonials.map((_, i) => (
        <button
          class={`testimonial-dot h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-green w-6' : 'bg-dark/10 w-3'}`}
          data-dot-index={i}
        />
      ))}
    </div>
  </div>

  <Reveal class="mt-8">
    <p class="text-sm text-text-secondary max-w-[58ch]">{t(locale, 'testimonialsBottom')}</p>
  </Reveal>
</Section>

<script>
  document.querySelectorAll('.testimonial-quote').forEach(container => {
    const text = container.querySelector('.testimonial-text') as HTMLElement;
    const btn = container.querySelector('.testimonial-expand') as HTMLButtonElement;
    if (!text || !btn) return;

    const readMoreText = btn.textContent || '';
    const readLessText = btn.closest('article')?.querySelector('[data-read-less]')?.textContent || '↑';

    requestAnimationFrame(() => {
      if (text.scrollHeight > text.clientHeight + 2) {
        btn.classList.remove('hidden');
      }
    });

    btn.addEventListener('click', () => {
      const isExpanded = !text.classList.contains('line-clamp-6');
      text.classList.toggle('line-clamp-6');
      btn.textContent = isExpanded ? readMoreText : '↑';
    });
  });

  const scrollContainer = document.getElementById('testimonials-scroll');
  const dots = document.querySelectorAll<HTMLButtonElement>('.testimonial-dot');

  if (scrollContainer && dots.length) {
    const children = scrollContainer.children;
    const updateDots = () => {
      const scrollLeft = scrollContainer.scrollLeft;
      const childWidth = (children[0] as HTMLElement)?.offsetWidth ?? 1;
      const gap = 20;
      const active = Math.round(scrollLeft / (childWidth + gap));
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-green', i === active);
        dot.classList.toggle('w-6', i === active);
        dot.classList.toggle('bg-dark/10', i !== active);
        dot.classList.toggle('w-3', i !== active);
      });
    };
    scrollContainer.addEventListener('scroll', updateDots, { passive: true });
    updateDots();

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const childWidth = (children[0] as HTMLElement)?.offsetWidth ?? 1;
        scrollContainer.scrollTo({ left: i * (childWidth + 20), behavior: 'smooth' });
      });
    });
  }
</script>
