---
import { t, getLocale } from '../../i18n';
import { testimonials } from '../../data/testimonials';
import { site } from '../../data/site';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
---

<Section id="testimonials" bg="paper-2">
  <SectionTitle>{t(locale, 'testimonialsTitle')}</SectionTitle>
  <p class="mt-3 text-sm text-ink-soft">{t(locale, 'testimonialsSub')}</p>
  <p class="mt-2 text-xs text-ink-soft">{t(locale, 'testimonialsHonest')}</p>

  <!-- Testimonials scroll container -->
  <div class="mt-10 relative">
    <div
      id="testimonials-scroll"
      class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 scrollbar-hide"
      style="-webkit-overflow-scrolling: touch;"
    >
      {testimonials.map((item, i) => {
        // On EN site, show translated tag for Ukrainian originals
        // On UK site, show translated tag for English originals
        const showTranslatedTag = locale === 'en' ? item.translated : !item.translated;
        const tagText = locale === 'en' ? t(locale, 'translatedFrom') : t(locale, 'translatedFrom');
        const quote = item.quote[locale] || item.quote.en; // fallback

        return (
          <Reveal
            delay={i * 60}
            class="flex-shrink-0 snap-start w-[85vw] max-w-sm md:w-[380px]"
          >
            <div class="relative flex h-full flex-col rounded-2xl border border-line bg-white p-6">
              <!-- Wine quotation mark doodle -->
              <svg class="absolute top-4 right-4 w-8 h-8 text-wine/20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C9.591 11.69 11 13.196 11 15c0 1.933-1.567 3.5-3.5 3.5-1.196 0-2.267-.568-2.917-1.179zM16.583 17.321C15.553 16.227 15 15 15 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C21.591 11.69 23 13.196 23 15c0 1.933-1.567 3.5-3.5 3.5-1.196 0-2.267-.568-2.917-1.179z"/>
              </svg>

              {/* Tags */}
              {item.translated && locale === 'en' && (
                <span class="mb-3 inline-flex self-start rounded-full bg-wine/10 text-wine px-3 py-0.5 text-xs font-medium">
                  {t(locale, 'translatedFrom')}
                </span>
              )}

              {/* Quote - clamped with read more */}
              <div class="testimonial-quote flex-1">
                <p class="text-ink-soft leading-relaxed line-clamp-6 testimonial-text whitespace-pre-line">{quote}</p>
                <button class="testimonial-expand mt-2 text-sm font-medium text-cobalt hover:text-cobalt-dk touch-manipulation hidden">
                  {t(locale, 'readMore')}
                </button>
              </div>

              {/* Author */}
              <div class="mt-4 pt-4 border-t border-line">
                <p class="font-semibold text-sm">{item.role[locale]}</p>
              </div>

              <a
                href={site.linkedinRecommendations}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center text-xs font-medium text-cobalt hover:text-cobalt-dk transition-colors touch-manipulation min-h-[44px]"
                data-event="outbound_linkedin"
                data-location="testimonials"
              >
                {t(locale, 'readOnLinkedin')} ↗
              </a>
            </div>
          </Reveal>
        );
      })}
    </div>

    <!-- Scroll dots -->
    <div id="testimonials-dots" class="mt-4 flex justify-center gap-2" aria-hidden="true">
      {testimonials.map((_, i) => (
        <button
          class="testimonial-dot h-2 w-2 rounded-full bg-line transition-colors duration-200"
          data-dot-index={i}
        />
      ))}
    </div>
  </div>
</Section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Read more toggle
  document.querySelectorAll('.testimonial-quote').forEach(container => {
    const text = container.querySelector('.testimonial-text') as HTMLElement;
    const btn = container.querySelector('.testimonial-expand') as HTMLButtonElement;
    if (!text || !btn) return;

    // Check if text is clamped
    requestAnimationFrame(() => {
      if (text.scrollHeight > text.clientHeight + 2) {
        btn.classList.remove('hidden');
      }
    });

    btn.addEventListener('click', () => {
      text.classList.toggle('line-clamp-6');
      btn.textContent = text.classList.contains('line-clamp-6') ? btn.textContent : '↑';
    });
  });

  // Scroll dots
  const scrollContainer = document.getElementById('testimonials-scroll');
  const dots = document.querySelectorAll<HTMLButtonElement>('.testimonial-dot');

  if (scrollContainer && dots.length) {
    const children = scrollContainer.children;
    const updateDots = () => {
      const scrollLeft = scrollContainer.scrollLeft;
      const childWidth = (children[0] as HTMLElement)?.offsetWidth ?? 1;
      const gap = 16;
      const active = Math.round(scrollLeft / (childWidth + gap));
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-cobalt', i === active);
        dot.classList.toggle('bg-line', i !== active);
      });
    };
    scrollContainer.addEventListener('scroll', updateDots, { passive: true });
    updateDots();

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const childWidth = (children[0] as HTMLElement)?.offsetWidth ?? 1;
        scrollContainer.scrollTo({ left: i * (childWidth + 16), behavior: 'smooth' });
      });
    });
  }
</script>
