---
import { Image } from 'astro:assets';
import { t, getLocale } from '../../i18n';
import lifeImg from '../../assets/images/nick-life.jpg';

const locale = getLocale(Astro.currentLocale);
---

<section id="about" class="py-24 md:py-28" style="background: #F4F4F4; scroll-margin-top: 72px;" aria-labelledby="about-heading">
  <div class="mx-auto max-w-[1240px] px-4 md:px-8">
    <div class="flex flex-col gap-10 lg:flex-row lg:gap-16 lg:items-start">
      <!-- Photo -->
      <div class="relative flex-shrink-0 lg:w-[340px] xl:w-[380px] lg:sticky lg:top-[90px]">
        <div class="relative mx-auto w-[260px] sm:w-[300px] lg:w-full">
          <div class="relative w-full rounded-[32px] overflow-hidden" style="aspect-ratio: 4/5; box-shadow: 0 30px 60px -30px rgba(26,32,54,0.3);">
            <Image
              src={lifeImg}
              alt="Nick Vvedenskyi"
              widths={[260, 300, 380, 520, 600, 760]}
              sizes="(max-width: 640px) 260px, (max-width: 1024px) 300px, 380px"
              class="w-full h-full object-cover object-[center_25%]"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Text -->
      <div class="flex-1">
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-text-secondary mb-4">{t(locale, 'aboutTitle')}</p>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="rounded-full bg-white px-3 py-1 text-sm font-medium text-dark border border-dark/[0.06]">{t(locale, 'aboutTag1')}</span>
          <span class="rounded-full bg-white px-3 py-1 text-sm font-medium text-dark border border-dark/[0.06]">{t(locale, 'aboutTag2')}</span>
          <span class="rounded-full bg-white px-3 py-1 text-sm font-medium text-dark border border-dark/[0.06]">{t(locale, 'aboutTag3')}</span>
        </div>

        <h2 id="about-heading" class="font-display text-[clamp(2rem,4vw,2.5rem)] font-bold text-dark tracking-[-0.035em]">{t(locale, 'aboutSub')}</h2>

        <div class="mt-6 space-y-4">
          <p class="text-text-secondary leading-relaxed max-w-[58ch]">{t(locale, 'aboutPanel0')}</p>
          <p class="text-text-secondary leading-relaxed max-w-[58ch]">{t(locale, 'aboutPanel1')}</p>
          <p class="text-text-secondary leading-relaxed max-w-[58ch]">{t(locale, 'aboutPanel2')}</p>
        </div>
      </div>
    </div>

    <!-- Belief block -->
    <div class="mt-16 md:mt-20">
      <div class="rounded-[28px] p-8 md:p-12" style="background: linear-gradient(135deg, #B1F171 0%, #99D4FF 100%);">
        <p class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] font-bold text-dark leading-[1.15] max-w-[30ch]">
          {t(locale, 'aboutBelief')}
        </p>
        <p class="mt-3 text-dark/70 max-w-[48ch]">{t(locale, 'aboutBeliefSub')}</p>
      </div>
    </div>
  </div>
</section>
