---
import HandwrittenNote from '../HandwrittenNote.astro';
import Reveal from '../Reveal.astro';

interface Props {
  text: string;
  rotate?: number;
  bg?: 'white' | 'bg';
}

const { text, rotate = -2, bg = 'white' } = Astro.props;
---

<section class={bg === 'bg' ? 'bg-bg' : 'bg-white'}>
  <div class="mx-auto max-w-[1240px] px-4 md:px-8 py-8 md:py-12">
    <Reveal class="text-center">
      <HandwrittenNote rotate={rotate} class="mx-auto text-2xl md:text-3xl">
        {text}
      </HandwrittenNote>
    </Reveal>
  </div>
</section>
