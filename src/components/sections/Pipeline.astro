---
import { t, getLocale } from '../../i18n';
import { services } from '../../data/services';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import HandwrittenNote from '../HandwrittenNote.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
---

<Section id="how-i-help" ariaLabelledby="how-i-help-heading">
  <SectionTitle id="how-i-help-heading">{t(locale, 'pipelineTitle')}</SectionTitle>
  <p class="mt-4 text-lg text-text-secondary leading-relaxed max-w-[58ch]">
    {t(locale, 'pipelineIntro')}
  </p>

  <!-- Step navigator -->
  <div class="mt-10" id="pipeline-navigator">
    <!-- Step indicator bar -->
    <div class="flex items-center justify-between mb-6">
      <p class="text-sm font-medium text-text-secondary">
        <span id="pipeline-step-label">{t(locale, 'stepOf')} 1 {t(locale, 'of')} {services.length}</span>
        <span class="mx-2 text-text-secondary/40">·</span>
        <span id="pipeline-step-name" class="text-dark font-bold">{services[0].name}</span>
      </p>
      <div class="flex gap-2">
        <button id="pipeline-prev" class="w-10 h-10 rounded-full bg-bg flex items-center justify-center text-dark hover:bg-green-light transition-colors disabled:opacity-30 disabled:cursor-not-allowed" disabled aria-label="Previous step">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L9.832 10l2.938 3.71a.75.75 0 11-1.04 1.08l-3.5-4.25a.75.75 0 010-1.08l3.5-4.25a.75.75 0 011.06.02z"/></svg>
        </button>
        <button id="pipeline-next" class="w-10 h-10 rounded-full bg-bg flex items-center justify-center text-dark hover:bg-green-light transition-colors disabled:opacity-30 disabled:cursor-not-allowed" aria-label="Next step">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L10.168 10 7.23 6.29a.75.75 0 111.04-1.08l3.5 4.25a.75.75 0 010 1.08l-3.5 4.25a.75.75 0 01-1.06-.02z"/></svg>
        </button>
      </div>
    </div>

    <!-- Progress dots -->
    <div class="flex gap-1.5 mb-8" id="pipeline-dots">
      {services.map((_, i) => (
        <button
          class={`pipeline-dot h-1.5 rounded-full transition-all duration-300 cursor-pointer ${i === 0 ? 'bg-green w-8' : 'bg-dark/10 w-4'}`}
          data-dot-index={i}
          aria-label={`Step ${i + 1}`}
        />
      ))}
    </div>

    <!-- Step cards container -->
    <div class="relative overflow-hidden" id="pipeline-cards">
      {services.map((s, i) => (
        <div
          class={`pipeline-card-panel transition-all duration-400 ${i === 0 ? '' : 'hidden'}`}
          data-panel-index={i}
        >
          <div class="card p-6 md:p-8">
            <div class="flex items-start gap-4 mb-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-full text-sm font-bold text-dark-alt font-display shrink-0" style={`background: ${['#CCE9FF', '#B1F171', '#F6B955', '#C4B5FD', '#CCE9FF', '#B1F171'][i]}`}>
                {s.step}
              </span>
              <div>
                <div class="flex items-center gap-3">
                  <h3 class="font-display text-xl md:text-2xl font-bold">{s.name}</h3>
                  {s.tag && <span class="rounded-full bg-green-light px-3 py-0.5 text-xs font-medium text-dark-alt">{s.tag[locale]}</span>}
                </div>
                <p class="mt-1 text-text-secondary leading-relaxed">{s.oneLiner[locale]}</p>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <div class="rounded-2xl bg-bg p-5">
                <p class="font-medium text-dark text-sm mb-2">{t(locale, 'whatIsInside')}</p>
                <ul class="space-y-1">
                  {s.whatIsInside[locale].map(item => (
                    <li class="text-sm text-text-secondary flex items-start gap-2">
                      <span class="text-green mt-0.5 shrink-0">·</span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="space-y-4">
                <div class="rounded-2xl bg-bg p-5">
                  <p class="font-medium text-dark text-sm mb-1">{t(locale, 'whatMoves')}</p>
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    {s.metrics[locale].map(m => (
                      <span class="rounded-full bg-white px-3 py-0.5 text-xs font-medium text-dark-alt border border-dark/5">{m}</span>
                    ))}
                  </div>
                </div>
                <div class="rounded-2xl bg-bg p-5">
                  <p class="font-medium text-dark text-sm mb-1">{t(locale, 'youGet')}</p>
                  <p class="text-sm text-text-secondary">{s.youGet[locale]}</p>
                </div>
                <div class="flex items-center gap-2 px-1">
                  <svg class="w-4 h-4 text-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span class="text-sm font-medium text-dark">{s.timeline[locale]}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <Reveal class="mt-10">
    <HandwrittenNote rotate={-2} withArrow="down" class="mb-4">
      {t(locale, 'pipelineCallNote')}
    </HandwrittenNote>
    <a href="#book" class="btn-primary text-base px-8 py-3.5" data-event="cta_book_call" data-location="pipeline">
      {t(locale, 'bookCall')}
      <svg class="ml-2 h-4 w-4 arrow-icon transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
  </Reveal>
</Section>

<script>
  const panels = document.querySelectorAll<HTMLElement>('.pipeline-card-panel');
  const dots = document.querySelectorAll<HTMLElement>('.pipeline-dot');
  const prevBtn = document.getElementById('pipeline-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('pipeline-next') as HTMLButtonElement;
  const stepLabel = document.getElementById('pipeline-step-label')!;
  const stepName = document.getElementById('pipeline-step-name')!;
  const total = panels.length;
  let current = 0;

  const names = Array.from(panels).map((_, i) => {
    const h3 = panels[i].querySelector('h3');
    return h3?.textContent || '';
  });

  function show(index: number) {
    current = index;
    panels.forEach((p, i) => {
      p.classList.toggle('hidden', i !== index);
    });
    dots.forEach((d, i) => {
      d.classList.toggle('bg-green', i === index);
      d.classList.toggle('w-8', i === index);
      d.classList.toggle('bg-dark/10', i !== index);
      d.classList.toggle('w-4', i !== index);
    });
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index === total - 1;
    const labelParts = stepLabel.textContent?.split(' ') || [];
    stepLabel.textContent = `${labelParts[0]} ${index + 1} ${labelParts[2]} ${total}`;
    stepName.textContent = names[index];
  }

  prevBtn.addEventListener('click', () => { if (current > 0) show(current - 1); });
  nextBtn.addEventListener('click', () => { if (current < total - 1) show(current + 1); });
  dots.forEach(d => {
    d.addEventListener('click', () => {
      const i = Number(d.dataset.dotIndex);
      if (!isNaN(i)) show(i);
    });
  });
</script>
