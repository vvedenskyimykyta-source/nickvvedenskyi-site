---
import { t, getLocale } from '../../i18n';
import { services } from '../../data/services';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import HandwrittenNote from '../HandwrittenNote.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);

const stepColors = ['bg-step-1', 'bg-step-2', 'bg-step-3', 'bg-step-4', 'bg-step-5', 'bg-step-6'];
---

<Section id="how-i-help">
  <!-- Divider note -->
  <Reveal class="mb-12 text-center">
    <HandwrittenNote rotate={-2} class="mx-auto text-2xl md:text-3xl">
      {t(locale, 'pipelineDivider')}
    </HandwrittenNote>
  </Reveal>

  <SectionTitle>{t(locale, 'pipelineTitle')}</SectionTitle>
  <p class="mt-4 text-lg text-ink-soft leading-relaxed max-w-3xl">
    {t(locale, 'pipelineIntro')}
  </p>

  <!-- Handwritten hint -->
  <Reveal class="mt-6">
    <HandwrittenNote rotate={-1} class="text-base">
      {t(locale, 'pipelineHint')}
    </HandwrittenNote>
  </Reveal>

  <!-- 3+3 grid of step cards -->
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="pipeline-grid">
    {services.map((s, i) => (
      <Reveal delay={i * 80}>
        <div
          class={`pipeline-card-wrap rounded-2xl border border-line transition-all duration-200 ${stepColors[i]}`}
          data-step={String(s.step)}
          id={`pipeline-step-${s.step}`}
          style="scroll-margin-top: 5rem;"
        >
          <button
            class="pipeline-step-btn w-full text-left p-5 md:p-6 cursor-pointer"
            aria-expanded={i === 0 ? 'true' : 'false'}
            data-event="pipeline_step_open"
            data-step-index={String(s.step)}
          >
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-start gap-3">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-cobalt text-sm font-bold text-white font-display shrink-0 mt-0.5">
                  {s.step}
                </span>
                <div>
                  <h3 class="font-display text-lg font-semibold leading-snug">{s.name}</h3>
                  <p class="mt-1 text-sm text-ink-soft leading-relaxed">{s.oneLiner[locale]}</p>
                </div>
              </div>
              <svg class="pipeline-chevron h-5 w-5 text-ink-soft transition-transform duration-300 shrink-0 mt-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/></svg>
            </div>
          </button>

          <div
            class="pipeline-step-content overflow-hidden transition-[max-height] duration-300 ease-in-out"
            style={i === 0 ? '' : 'max-height: 0;'}
          >
            <div class="px-5 pb-5 md:px-6 md:pb-6 pt-0">
              <div class="rounded-xl bg-white/60 p-4">
                <div class="text-sm">
                  <p class="font-medium text-ink mb-1">{t(locale, 'whatIsInside')}:</p>
                  <p class="text-ink-soft leading-relaxed">{s.whatIsInside[locale]}</p>
                </div>
                <div class="mt-3 pt-3 border-t border-line text-sm">
                  <p class="font-medium text-ink mb-1">{t(locale, 'youGet')}:</p>
                  <p class="text-ink-soft leading-relaxed">{s.youGet[locale]}</p>
                </div>
                <div class="mt-3 pt-3 border-t border-line">
                  <span class="text-sm font-medium text-cobalt">{s.timeline[locale]}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Reveal>
    ))}
  </div>

  <!-- CTA -->
  <Reveal class="mt-10">
    <HandwrittenNote rotate={-2} withArrow="down" class="mb-4">
      {t(locale, 'pipelineCallNote')}
    </HandwrittenNote>
    <a href="#book" class="btn-primary" data-event="cta_book_call" data-location="pipeline">
      {t(locale, 'bookCall')}
      <svg class="ml-2 h-4 w-4 arrow-icon transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
  </Reveal>
</Section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pipeline-step-btn');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const content = btn.nextElementSibling as HTMLElement | null;
      if (!content) return;

      if (isExpanded) {
        btn.setAttribute('aria-expanded', 'false');
        content.style.maxHeight = '0';
        const chevron = btn.querySelector('.pipeline-chevron');
        if (chevron) (chevron as HTMLElement).style.transform = '';
      } else {
        // Close all others
        buttons.forEach(other => {
          if (other === btn) return;
          other.setAttribute('aria-expanded', 'false');
          const otherContent = other.nextElementSibling as HTMLElement | null;
          if (otherContent) otherContent.style.maxHeight = '0';
          const otherChevron = other.querySelector('.pipeline-chevron');
          if (otherChevron) (otherChevron as HTMLElement).style.transform = '';
        });

        btn.setAttribute('aria-expanded', 'true');
        content.style.maxHeight = content.scrollHeight + 'px';
        const chevron = btn.querySelector('.pipeline-chevron');
        if (chevron) (chevron as HTMLElement).style.transform = 'rotate(180deg)';
      }

      const step = btn.dataset.stepIndex;
      if (step && window.dataLayer) {
        window.dataLayer.push({ event: 'pipeline_step_open', step });
      }
    });
  });

  // Initialize first card as open
  const firstBtn = buttons[0];
  if (firstBtn) {
    const content = firstBtn.nextElementSibling as HTMLElement | null;
    if (content) {
      content.style.maxHeight = content.scrollHeight + 'px';
      const chevron = firstBtn.querySelector('.pipeline-chevron');
      if (chevron) (chevron as HTMLElement).style.transform = 'rotate(180deg)';
    }
  }

  declare global {
    interface Window {
      dataLayer?: Array<Record<string, unknown>>;
    }
  }
</script>
