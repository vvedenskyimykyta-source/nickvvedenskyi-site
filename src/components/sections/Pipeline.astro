---
import { t, getLocale } from '../../i18n';
import { services } from '../../data/services';

const locale = getLocale(Astro.currentLocale);
---

<section id="how-i-help" class="relative overflow-hidden py-24 md:py-28" style="background: #F4F4F4; scroll-margin-top: 72px;" aria-labelledby="how-i-help-heading">
  <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px]" style="background: radial-gradient(ellipse, rgba(204,233,255,0.9), transparent);" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1240px] px-4 md:px-8">
    <p class="font-hand text-[22px] text-green-dark" style="transform: rotate(-2deg); transform-origin: left;">{t(locale, 'pipelineDivider')}</p>

    <h2 id="how-i-help-heading" class="mt-4 font-display text-[clamp(2.25rem,4.5vw,2.75rem)] font-bold text-dark tracking-[-0.04em]">
      {t(locale, 'pipelineTitle')}
    </h2>

    <p class="mt-4 text-lg text-text-secondary leading-relaxed max-w-[58ch]">
      {t(locale, 'pipelineIntro')}
    </p>

    <p class="mt-2 text-sm text-text-secondary/60">{t(locale, 'pipelineHint')}</p>

    <div class="mt-10 grid gap-6 lg:grid-cols-[320px_1fr] lg:gap-8">
      <!-- Step list (left) -->
      <div class="space-y-0" id="pipeline-steps">
        {services.map((s, i) => (
          <button
            class={`pipeline-step w-full flex items-center gap-4 px-4 py-3.5 rounded-xl text-left transition-all duration-200 group ${i === 0 ? 'bg-white shadow-sm' : 'hover:bg-white/60'}`}
            data-step-index={i}
            type="button"
          >
            <span class={`w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold shrink-0 ${i === 0 ? 'bg-green text-dark' : 'bg-dark/[0.06] text-dark/60'}`}>
              {s.step}
            </span>
            <div class="flex-1 min-w-0">
              <span class="block font-display font-bold text-dark text-[15px]">{s.name}</span>
              <span class="block text-xs font-medium text-text-secondary/60 uppercase tracking-wide mt-0.5">{s.subtitle[locale]}</span>
            </div>
            <svg class={`w-4 h-4 shrink-0 transition-opacity ${i === 0 ? 'opacity-100' : 'opacity-0 group-hover:opacity-50'}`} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 4l4 4-4 4"/></svg>
          </button>
        ))}
      </div>

      <!-- Detail panel (right) -->
      <div id="pipeline-panels">
        {services.map((s, i) => (
          <div
            class={`pipeline-panel ${i === 0 ? '' : 'hidden'}`}
            data-panel-index={i}
          >
            <div class="bg-white rounded-[32px] overflow-hidden" style="box-shadow: 0 1px 2px rgba(26,26,46,0.04), 0 30px 60px -30px rgba(26,26,46,0.22);">
              <div class="bg-deep text-white p-8 md:p-10">
                <div class="flex items-center gap-3 mb-1">
                  <span class="text-sm font-medium text-white/50">{t(locale, 'stepOf')} {s.step} {t(locale, 'of')} {services.length} · {s.name}</span>
                </div>
                {s.tag && <span class="inline-block mt-2 rounded-full bg-green-light px-3 py-1 text-xs font-semibold text-dark">{s.tag[locale]}</span>}
                <p class="mt-3 text-sm font-medium text-white/60 tracking-wide">{s.subtitle[locale]}</p>
                <h3 class="mt-2 font-display text-2xl md:text-3xl font-bold">{s.oneLiner[locale]}</h3>
              </div>

              <div class="p-8 md:p-10">
                <div class="grid gap-6 md:grid-cols-2">
                  <div>
                    <p class="font-mono text-xs font-medium text-text-secondary tracking-[0.06em] uppercase mb-3">{t(locale, 'whatIsInside')}</p>
                    <ul class="space-y-2">
                      {s.whatIsInside[locale].map(item => (
                        <li class="flex items-center gap-2.5 text-[15px] text-dark">
                          <span class="w-[22px] h-[22px] rounded-full bg-green-pale flex items-center justify-center shrink-0">
                            <svg class="w-3 h-3 text-green-dark" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="2 6 5 9 10 3"/></svg>
                          </span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="space-y-5">
                    <div>
                      <p class="font-mono text-xs font-medium text-text-secondary tracking-[0.06em] uppercase mb-2">{locale === 'en' ? 'Timeline' : 'Термін'}</p>
                      <p class="text-lg font-semibold text-dark">{s.timeline[locale]}</p>
                    </div>
                    <div>
                      <p class="font-mono text-xs font-medium text-text-secondary tracking-[0.06em] uppercase mb-2">{t(locale, 'whatMoves')}</p>
                      <div class="flex flex-wrap gap-1.5">
                        {s.metrics[locale].map(m => (
                          <span class="rounded-full bg-bg px-3 py-1 text-xs font-medium text-dark">{m}</span>
                        ))}
                      </div>
                    </div>
                    <div>
                      <p class="font-mono text-xs font-medium text-text-secondary tracking-[0.06em] uppercase mb-2">{t(locale, 'youGet')}</p>
                      <p class="text-[15px] text-text-secondary leading-relaxed">{s.youGet[locale]}</p>
                    </div>
                  </div>
                </div>

                <a href="#book" class="btn-primary mt-8 inline-flex" data-event="cta_book_call" data-location="pipeline">
                  {t(locale, 'bookCall')}
                  <svg class="h-4 w-4 arrow-icon transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const steps = document.querySelectorAll<HTMLElement>('.pipeline-step');
  const panels = document.querySelectorAll<HTMLElement>('.pipeline-panel');

  function show(index: number) {
    panels.forEach((p, i) => p.classList.toggle('hidden', i !== index));
    steps.forEach((s, i) => {
      const active = i === index;
      s.classList.toggle('bg-white', active);
      s.classList.toggle('shadow-sm', active);
      s.classList.toggle('hover:bg-white/60', !active);
      const circle = s.querySelector('span:first-child') as HTMLElement;
      if (circle) {
        circle.classList.toggle('bg-green', active);
        circle.classList.toggle('text-dark', active);
        circle.classList.toggle('bg-dark/[0.06]', !active);
        circle.classList.toggle('text-dark/60', !active);
      }
      const arrow = s.querySelector('svg') as HTMLElement;
      if (arrow) {
        arrow.classList.toggle('opacity-100', active);
        arrow.classList.toggle('opacity-0', !active);
      }
    });
  }

  steps.forEach(step => {
    step.addEventListener('click', () => {
      const i = Number(step.dataset.stepIndex);
      if (!isNaN(i)) show(i);
    });
  });
</script>
