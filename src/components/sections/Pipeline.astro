---
import { t, getLocale } from '../../i18n';
import { services } from '../../data/services';
import Section from '../Section.astro';
import SectionTitle from '../SectionTitle.astro';
import HandwrittenNote from '../HandwrittenNote.astro';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);

---

<Section id="how-i-help" class="pt-20 md:pt-28" ariaLabelledby="how-i-help-heading">
  <div class="deco-blob deco-blob-blue -right-48 -top-24 hidden md:block" aria-hidden="true"></div>
  <!-- Divider note -->
  <Reveal class="mb-12 text-center">
    <HandwrittenNote rotate={-2} class="mx-auto text-2xl md:text-3xl">
      {t(locale, 'pipelineDivider')}
    </HandwrittenNote>
  </Reveal>

  <SectionTitle id="how-i-help-heading">{t(locale, 'pipelineTitle')}</SectionTitle>
  <p class="mt-4 text-lg text-ink-soft leading-relaxed max-w-[58ch]">
    {t(locale, 'pipelineIntro')}
  </p>

  <!-- Handwritten hint -->
  <Reveal class="mt-6">
    <HandwrittenNote rotate={-1} class="text-base">
      {t(locale, 'pipelineHint')}
    </HandwrittenNote>
  </Reveal>

  <!-- 3+3 grid of step cards -->
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="pipeline-grid">
    {services.map((s, i) => (
      <Reveal delay={i * 80}>
        <div
          class="pipeline-card glass-card transition-all duration-300"
          data-step={String(s.step)}
        >
          <button
            class="pipeline-step-btn w-full text-left p-5 md:p-6 cursor-pointer"
            id={`pipeline-btn-${s.step}`}
            aria-expanded={i === 0 ? 'true' : 'false'}
            data-event="pipeline_step_open"
            data-step-index={String(s.step)}
          >
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-cobalt text-sm font-bold text-white font-display shrink-0">
                  {s.step}
                </span>
                <div>
                  <h3 class="font-display text-lg font-semibold leading-snug">{s.name}</h3>
                  <p class="mt-1 text-sm text-ink-soft leading-relaxed">{s.oneLiner[locale]}</p>
                </div>
              </div>
              <!-- Lucide icon + chevron -->
              <div class="flex items-center gap-2 shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-cobalt/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {s.icon === 'messages-square' && <><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v5Z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></>}
                  {s.icon === 'target' && <><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></>}
                  {s.icon === 'handshake' && <><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88"/><path d="m11 17-2-2a1 1 0 1 0-3 3"/><path d="m10 14-2.5-2.5a1 1 0 1 0-3 3l3.88 3.88"/><path d="M7 4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2H7z"/></>}
                  {s.icon === 'heart-handshake' && <><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08v0c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"/><path d="m18 15-2-2"/><path d="m15 18-2-2"/></>}
                  {s.icon === 'trending-up' && <><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></>}
                  {s.icon === 'rocket' && <><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></>}
                </svg>
                <svg class="pipeline-chevron h-5 w-5 text-ink-soft transition-transform duration-300 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/></svg>
              </div>
            </div>
          </button>

          <div
            class="pipeline-step-content overflow-hidden transition-[max-height,opacity] duration-300 ease-in-out"
            role="region"
            aria-labelledby={`pipeline-btn-${s.step}`}
            style={i === 0 ? '' : 'max-height: 0; opacity: 0;'}
          >
            <div class="px-5 pb-5 md:px-6 md:pb-6 pt-0">
              <div class="rounded-xl bg-white/60 p-4">
                <div class="text-sm">
                  <p class="font-medium text-ink mb-1">{t(locale, 'whatIsInside')}:</p>
                  <p class="text-ink-soft leading-relaxed">{s.whatIsInside[locale]}</p>
                </div>
                <div class="mt-3 pt-3 border-t border-line text-sm">
                  <p class="font-medium text-ink mb-1">{t(locale, 'youGet')}:</p>
                  <p class="text-ink-soft leading-relaxed">{s.youGet[locale]}</p>
                </div>
                <div class="mt-3 pt-3 border-t border-line">
                  <span class="text-sm font-medium text-cobalt">{s.timeline[locale]}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Reveal>
    ))}
  </div>

  <!-- CTA -->
  <Reveal class="mt-10">
    <HandwrittenNote rotate={-2} withArrow="down" class="mb-4">
      {t(locale, 'pipelineCallNote')}
    </HandwrittenNote>
    <a href="#book" class="btn-primary btn-magnetic text-base px-8 py-3.5" data-event="cta_book_call" data-location="pipeline">
      {t(locale, 'bookCall')}
      <svg class="ml-2 h-4 w-4 arrow-icon transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
  </Reveal>
</Section>

<style>
  .pipeline-card {
    opacity: 0.85;
  }
  .pipeline-card.pipeline-active {
    opacity: 1;
    border-left: 4px solid var(--color-cobalt);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pipeline-step-btn');

  function setActive(activeBtn: HTMLButtonElement) {
    buttons.forEach(other => {
      const wrap = other.closest('.pipeline-card');
      const isThis = other === activeBtn;
      const content = other.nextElementSibling as HTMLElement | null;
      const chevron = other.querySelector('.pipeline-chevron') as HTMLElement | null;

      if (isThis && other.getAttribute('aria-expanded') !== 'true') {
        other.setAttribute('aria-expanded', 'true');
        if (content) {
          content.style.maxHeight = content.scrollHeight + 'px';
          content.style.opacity = '1';
        }
        if (chevron) chevron.style.transform = 'rotate(180deg)';
        wrap?.classList.add('pipeline-active');
      } else if (!isThis) {
        other.setAttribute('aria-expanded', 'false');
        if (content) {
          content.style.maxHeight = '0';
          content.style.opacity = '0';
        }
        if (chevron) chevron.style.transform = '';
        wrap?.classList.remove('pipeline-active');
      }
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        const content = btn.nextElementSibling as HTMLElement | null;
        const chevron = btn.querySelector('.pipeline-chevron') as HTMLElement | null;
        const wrap = btn.closest('.pipeline-card');
        btn.setAttribute('aria-expanded', 'false');
        if (content) { content.style.maxHeight = '0'; content.style.opacity = '0'; }
        if (chevron) chevron.style.transform = '';
        wrap?.classList.remove('pipeline-active');
      } else {
        setActive(btn);
      }

      const step = btn.dataset.stepIndex;
      if (step && window.dataLayer) {
        window.dataLayer.push({ event: 'pipeline_step_open', step });
      }
    });
  });

  // Initialize first card as open
  const firstBtn = buttons[0];
  if (firstBtn) {
    setActive(firstBtn);
  }

  declare global {
    interface Window {
      dataLayer?: Array<Record<string, unknown>>;
    }
  }
</script>
