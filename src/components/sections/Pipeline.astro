---
import { t, getLocale } from '../../i18n';
import { services } from '../../data/services';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
const timelineLabel = locale === 'en' ? 'Timeline' : 'Термін';
---

<section id="how-i-help" class="pipeline" aria-labelledby="how-i-help-heading">
  <div class="pipeline-glow" aria-hidden="true"></div>

  <div class="pipeline-inner">
    <Reveal>
      <div class="pipeline-head">
        <div class="font-hand pipeline-eyebrow">{t(locale, 'pipelineDivider')}</div>
        <h2 id="how-i-help-heading" class="font-display pipeline-title">{t(locale, 'pipelineTitle')}</h2>
        <p class="pipeline-intro">{t(locale, 'pipelineIntro')}</p>
      </div>
    </Reveal>

    <Reveal>
      <div class="pipeline-row">
        <!-- Step list (left) -->
        <div class="pipeline-left">
          <div class="font-hand pipeline-hint">{t(locale, 'pipelineHint')}</div>

          <div class="pipeline-steps" id="pipeline-steps">
            <div class="pipeline-track" aria-hidden="true"></div>
            <div class="pipeline-track-fill" id="pipeline-track-fill" aria-hidden="true"></div>

            {services.map((s, i) => (
              <button type="button" class="pipeline-step" data-step-index={i} aria-pressed={i === 0}>
                <span class="font-display pipeline-dot">{s.step}</span>
                <span class="pipeline-step-text">
                  <span class="font-display pipeline-step-name">{s.name}</span>
                  <span class="font-mono pipeline-step-sub">{s.subtitle[locale]}</span>
                </span>
                <span class="pipeline-step-arrow">→</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Detail panel (right) -->
        <div class="pipeline-card">
          {services.map((s, i) => (
            <div class={`pipeline-panel ${i === 0 ? '' : 'is-hidden'}`} data-panel-index={i}>
              <div class="pipeline-panel-head">
                <div class="pipeline-panel-glow" aria-hidden="true"></div>

                <div class="pipeline-panel-meta">
                  <span class="font-mono pipeline-panel-step">
                    {t(locale, 'stepOf')} {s.step} {t(locale, 'of')} {services.length} · {s.name}
                  </span>
                  {s.tag && <span class="pipeline-panel-tag">{s.tag[locale]}</span>}
                </div>

                <h3 class="font-display pipeline-panel-title">{s.subtitle[locale]}</h3>
                <p class="font-display pipeline-panel-line">{s.oneLiner[locale]}</p>
              </div>

              <div class="pipeline-panel-body">
                <div class="pipeline-inside">
                  <div class="font-mono pipeline-label">{t(locale, 'whatIsInside')}</div>
                  <div class="pipeline-inside-list">
                    {s.whatIsInside[locale].map(item => (
                      <div class="pipeline-inside-item">
                        <span class="pipeline-check">✓</span>{item}
                      </div>
                    ))}
                  </div>
                  <div class="pipeline-timeline">
                    <div>
                      <div class="font-mono pipeline-label">{timelineLabel}</div>
                      <div class="font-display pipeline-timeline-value">{s.timeline[locale]}</div>
                    </div>
                  </div>
                </div>

                <div class="pipeline-aside">
                  <div class="pipeline-moves">
                    <div class="font-mono pipeline-label pipeline-label-tight">{t(locale, 'whatMoves')}</div>
                    <div class="pipeline-moves-list">
                      {s.metrics[locale].map(m => (
                        <div class="font-display pipeline-move">
                          <span class="pipeline-move-dot"></span>{m}
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="pipeline-get">
                    <div class="font-mono pipeline-label pipeline-label-tight pipeline-label-dark">{t(locale, 'youGet')}</div>
                    <div class="font-display pipeline-get-text">{s.youGet[locale]}</div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Reveal>

    <Reveal>
      <div class="pipeline-cta">
        <a href="#book" class="pipeline-cta-btn" data-event="cta_book_call" data-location="pipeline">
          <span>{t(locale, 'bookCall')}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
        </a>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .pipeline {
    scroll-margin-top: 72px;
    position: relative;
    padding: 100px 0 110px;
    background: #F4F4F4;
    overflow: hidden;
    overflow: clip;
  }
  .pipeline-glow {
    position: absolute;
    width: 900px;
    height: 500px;
    left: 50%;
    top: -240px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(204, 233, 255, .9), rgba(204, 233, 255, 0) 70%);
    pointer-events: none;
  }
  .pipeline-inner {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .pipeline-head {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .pipeline-eyebrow {
    font-size: 34px;
    line-height: 1.2;
    color: #4E8F0F;
    transform: rotate(-2deg);
    display: inline-block;
  }
  .pipeline-title {
    font-weight: 700;
    font-size: clamp(36px, 4.2vw, 58px);
    line-height: 1.03;
    letter-spacing: -0.04em;
    margin: 10px 0 0;
    text-wrap: balance;
    color: #1A1A2E;
  }
  .pipeline-intro {
    font-size: 17px;
    line-height: 1.55;
    color: #454545;
    margin: 20px auto 0;
    max-width: 640px;
    text-wrap: pretty;
  }

  .pipeline-row {
    margin-top: 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    align-items: flex-start;
  }
  .pipeline-left {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .pipeline-hint {
    font-size: 24px;
    color: #4E8F0F;
    transform: rotate(-2deg);
    margin: 0 0 12px 8px;
    align-self: flex-start;
  }

  .pipeline-steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pipeline-track {
    position: absolute;
    left: 35px;
    top: 34px;
    bottom: 34px;
    width: 3px;
    border-radius: 3px;
    background: #E2E2E2;
  }
  .pipeline-track-fill {
    position: absolute;
    left: 35px;
    top: 34px;
    width: 3px;
    border-radius: 3px;
    height: 0;
    background: linear-gradient(180deg, #99D4FF, #6EC319);
    transition: height .45s cubic-bezier(.2, .8, .2, 1);
  }

  .pipeline-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px 12px 14px;
    border-radius: 20px;
    border: none;
    background: transparent;
    box-shadow: none;
    text-align: left;
    color: #1A1A2E;
    transition: all .25s ease;
  }
  .pipeline-step.is-active {
    background: #FFFFFF;
    box-shadow: 0 12px 28px -14px rgba(26, 26, 46, .28);
  }

  .pipeline-dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 17px;
    background: #FFFFFF;
    color: #1A1A2E;
    box-shadow: 0 0 0 1px #E2E2E2;
    flex: 0 0 auto;
    transition: all .25s ease;
  }
  .pipeline-step.is-active .pipeline-dot {
    background: #6EC319;
    box-shadow: 0 8px 18px -8px rgba(110, 195, 25, .9);
  }

  .pipeline-step-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }
  .pipeline-step-name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    opacity: .6;
    transition: opacity .25s ease;
  }
  .pipeline-step.is-active .pipeline-step-name {
    opacity: 1;
  }
  .pipeline-step-sub {
    font-size: 11px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #454545;
  }
  .pipeline-step-arrow {
    color: #4E8F0F;
    font-size: 16px;
    opacity: 0;
    transition: opacity .25s ease;
  }
  .pipeline-step.is-active .pipeline-step-arrow {
    opacity: 1;
  }

  .pipeline-card {
    flex: 2 1 560px;
    min-width: 0;
    background: #FFFFFF;
    border-radius: 32px;
    box-shadow: 0 1px 2px rgba(26, 26, 46, .04), 0 30px 60px -30px rgba(26, 26, 46, .22);
    overflow: hidden;
  }
  .pipeline-panel.is-hidden {
    display: none;
  }

  .pipeline-panel-head {
    position: relative;
    overflow: hidden;
    overflow: clip;
    padding: 36px 40px 32px;
    background: #1A2036;
    color: #FFFFFF;
  }
  .pipeline-panel-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    right: -140px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(110, 195, 25, .45), rgba(110, 195, 25, 0) 70%);
    pointer-events: none;
  }
  .pipeline-panel-meta {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pipeline-panel-step {
    font-size: 13px;
    color: #99D4FF;
  }
  .pipeline-panel-tag {
    font-size: 12px;
    font-weight: 600;
    padding: 5px 11px;
    border-radius: 999px;
    background: #B1F171;
    color: #1A1A2E;
  }
  .pipeline-panel-title {
    position: relative;
    margin: 14px 0 0;
    font-weight: 700;
    font-size: clamp(32px, 3.6vw, 46px);
    line-height: 1.03;
    letter-spacing: -0.035em;
  }
  .pipeline-panel-line {
    position: relative;
    margin: 12px 0 0;
    font-size: 20px;
    line-height: 1.4;
    color: #CCE9FF;
    max-width: 540px;
  }

  .pipeline-panel-body {
    padding: 32px 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 32px;
  }
  .pipeline-label {
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #454545;
    margin-bottom: 16px;
  }
  .pipeline-label-tight {
    margin-bottom: 8px;
  }
  .pipeline-label-dark {
    color: #1A1A2E;
  }

  .pipeline-inside {
    display: flex;
    flex-direction: column;
  }
  .pipeline-inside-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pipeline-inside-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    color: #1A1A2E;
  }
  .pipeline-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #E4F8CF;
    color: #4E8F0F;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
    flex: 0 0 auto;
  }
  .pipeline-timeline {
    margin-top: auto;
    padding-top: 28px;
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .pipeline-timeline-value {
    font-size: 22px;
    font-weight: 700;
    margin-top: 4px;
    letter-spacing: -0.02em;
    color: #1A1A2E;
  }

  .pipeline-aside {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pipeline-moves {
    background: #F4F4F4;
    border-radius: 20px;
    padding: 22px 24px;
  }
  .pipeline-moves-list {
    display: flex;
    flex-direction: column;
  }
  .pipeline-move {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(26, 26, 46, .08);
    font-size: 17px;
    font-weight: 500;
    color: #1A1A2E;
  }
  .pipeline-move-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #6EC319;
    flex: 0 0 auto;
  }
  .pipeline-get {
    background: #B1F171;
    border-radius: 20px;
    padding: 20px 24px;
  }
  .pipeline-get-text {
    font-size: 19px;
    line-height: 1.35;
    font-weight: 500;
    color: #1A1A2E;
  }

  .pipeline-cta {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .pipeline-cta-btn {
    background: #6EC319;
    color: #1A1A2E;
    padding: 22px 44px;
    min-width: 340px;
    justify-content: center;
    border-radius: 999px;
    font-weight: 600;
    font-size: 19px;
    box-shadow: 0 10px 24px -10px rgba(110, 195, 25, .8);
    display: flex;
    align-items: center;
    gap: 10px;
    transition: background .2s ease;
  }
  .pipeline-cta-btn:hover {
    background: #7FD62A;
    color: #1A1A2E;
  }
</style>

<script>
  const stepsWrap = document.getElementById('pipeline-steps');
  const steps = document.querySelectorAll<HTMLElement>('.pipeline-step');
  const panels = document.querySelectorAll<HTMLElement>('.pipeline-panel');
  const fill = document.getElementById('pipeline-track-fill');

  function show(index: number) {
    panels.forEach((p, i) => p.classList.toggle('is-hidden', i !== index));
    steps.forEach((s, i) => {
      s.classList.toggle('is-active', i === index);
      s.setAttribute('aria-pressed', String(i === index));
    });
    // Track fill reaches the active dot's centre; the track starts at the first dot's centre,
    // so the offset of the active button from the top is exactly the height needed.
    const active = steps[index];
    if (fill && active) fill.style.height = `${active.offsetTop}px`;
  }

  steps.forEach(step => {
    step.addEventListener('click', () => {
      const i = Number(step.dataset.stepIndex);
      if (!Number.isNaN(i)) show(i);
    });
  });

  if (stepsWrap && steps.length) show(0);
</script>
