---
import { getLocale } from '../../i18n';
import { numbers } from '../../data/numbers';
import Reveal from '../Reveal.astro';

const locale = getLocale(Astro.currentLocale);
---

<section class="relative bg-deep" aria-label={locale === 'en' ? 'Key numbers' : 'Ключові цифри'} style="scroll-margin-top: 5rem;">
  <div class="mx-auto max-w-7xl px-5 md:px-6 py-16 md:py-24">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 md:gap-12">
      {numbers.map((n, i) => (
        <Reveal delay={i * 80}>
          <div class="text-center">
            <div class="relative inline-flex items-baseline">
              <span
                class="font-display text-[clamp(3rem,8vw,5rem)] font-bold text-green-light leading-none tracking-[-0.03em]"
                data-count-to={n.value}
              >
                {n.value}
              </span>
              {n.suffix && (
                <span class="font-display text-[clamp(1.5rem,3vw,2.5rem)] font-bold text-green-light">{n.suffix}</span>
              )}
            </div>
            <p class="mt-2 text-sm text-text-on-dark-muted uppercase tracking-wider leading-snug">{n.label[locale]}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>

<script>
  function animateCountUp() {
    const els = document.querySelectorAll<HTMLElement>('[data-count-to]');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countTo || '0', 10);
        const duration = 1200;
        const start = performance.now();
        observer.unobserve(el);

        function tick(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(eased * target));
          if (progress < 1) requestAnimationFrame(tick);
        }
        el.textContent = '0';
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.3 });

    els.forEach((el) => observer.observe(el));
  }
  animateCountUp();
</script>
