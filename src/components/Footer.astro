---
import { t, getLocale } from '../i18n';
import { site } from '../data/site';

const locale = getLocale(Astro.currentLocale);
---

<footer class="bg-paper-2 border-t border-line">
  <div class="mx-auto max-w-7xl px-5 md:px-6 py-12 md:py-16">
    <div class="flex flex-col gap-8">
      <!-- Top -->
      <div class="flex flex-col gap-4">
        <p class="font-display text-lg font-semibold">{site.name} · {t(locale, 'footerTagline')}</p>
        <address class="not-italic flex gap-4 items-center">
          {site.linkedin && (
            <a
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-soft hover:text-cobalt transition-colors touch-manipulation min-w-[44px] min-h-[44px] flex items-center justify-center"
              data-event="outbound_linkedin"
              data-location="footer"
              aria-label="LinkedIn"
            >
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          )}
          {site.instagram && (
            <a
              href={site.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-soft hover:text-cobalt transition-colors touch-manipulation min-h-[44px] flex items-center gap-2"
              data-event="outbound_instagram"
              data-location="footer"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 100 12.324 6.162 6.162 0 100-12.324zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405a1.441 1.441 0 11-2.88 0 1.441 1.441 0 012.88 0z"/></svg>
              <span class="text-sm">{t(locale, 'footerInstagram')}</span>
            </a>
          )}
          {site.email && (
            <a
              href={`mailto:${site.email}`}
              class="text-ink-soft hover:text-cobalt transition-colors touch-manipulation min-w-[44px] min-h-[44px] flex items-center justify-center"
              data-event="click_email"
              data-location="footer"
              aria-label="Email"
            >
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
          )}
        </address>
      </div>

      <!-- Divider -->
      <hr class="border-line" />

      <!-- Bottom -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap gap-4 sm:gap-6">
          <a href={locale === 'uk' ? '/uk/privacy' : '/privacy'} class="text-sm text-ink-soft hover:text-ink transition-colors touch-manipulation min-h-[44px] flex items-center">
            {t(locale, 'footerPrivacy')}
          </a>
          <button
            id="cookie-settings-btn"
            class="text-sm text-ink-soft hover:text-ink transition-colors touch-manipulation min-h-[44px] flex items-center"
          >
            {t(locale, 'footerCookies')}
          </button>
          <a
            href={t(locale, 'langSwitchHref')}
            class="text-sm font-semibold text-cobalt hover:text-cobalt-dk transition-colors touch-manipulation min-h-[44px] flex items-center"
            data-event="lang_switch"
            data-location="footer"
          >
            {t(locale, 'langSwitchLabel')}
          </a>
        </div>
        <p class="text-sm text-ink-soft">{t(locale, 'footerMade')}</p>
      </div>
    </div>
  </div>
</footer>
