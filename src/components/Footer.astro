---
import { t, getLocale } from '../i18n';
import { site } from '../data/site';

const locale = getLocale(Astro.currentLocale);
const year = new Date().getFullYear();
const altLocale = locale === 'uk' ? { href: '/', label: 'EN' } : { href: '/uk/', label: 'UA' };
---

<footer class="ft">
  <div class="ft-glow" aria-hidden="true"></div>

  <div class="ft-inner">
    <div class="ft-top">
      <div>
        <div class="font-display ft-name">{site.name}</div>
        <div class="ft-tagline">{t(locale, 'footerTagline')}</div>
      </div>

      <div class="ft-socials">
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="ft-social"
          aria-label="LinkedIn"
          data-event="outbound_linkedin"
          data-location="footer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="9" width="4" height="13" rx="1"/><circle cx="4" cy="4.5" r="2.2"/><path d="M9 9h3.8v1.9c.6-1.1 2-2.2 4.1-2.2 4 0 4.6 2.6 4.6 6V22h-4v-6.3c0-1.6 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3V22H9z"/></svg>
        </a>
        <a
          href={`mailto:${site.email}`}
          class="ft-social"
          aria-label="Email"
          data-event="click_email"
          data-location="footer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
        </a>
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="ft-social"
          aria-label="Instagram"
          data-event="outbound_instagram"
          data-location="footer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>

    <div class="ft-bottom">
      <span class="ft-copy">© {year} {site.name}. {t(locale, 'footerRights')}</span>
      <span class="ft-links">
        <a href={locale === 'uk' ? '/uk/privacy' : '/privacy'}>{t(locale, 'footerPrivacy')}</a>
        <button type="button" id="cookie-settings-btn" class="ft-cookie">{t(locale, 'footerCookies')}</button>
        <a href={altLocale.href}>{altLocale.label}</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: #1A2036;
    color: #FFFFFF;
    position: relative;
    overflow: hidden;
    overflow: clip;
  }
  .ft-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    right: -200px;
    top: -300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(110, 195, 25, .25), rgba(110, 195, 25, 0) 70%);
    pointer-events: none;
  }
  .ft-inner {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: 72px 32px 36px;
  }

  .ft-top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
  }
  .ft-name {
    font-weight: 700;
    font-size: clamp(32px, 4vw, 52px);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .ft-tagline {
    margin-top: 10px;
    font-size: 16px;
    color: #CCE9FF;
  }

  .ft-socials {
    display: flex;
    gap: 8px;
  }
  .ft-social {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, .08);
    color: #FFFFFF;
    transition: background .2s ease, color .2s ease;
  }
  .ft-social:hover {
    background: #6EC319;
    color: #1A1A2E;
  }

  .ft-bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, .1);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    color: #CCE9FF;
  }
  .ft-copy {
    max-width: 640px;
  }
  .ft-links {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .ft-links a,
  .ft-cookie {
    color: #CCE9FF;
    font-size: 14px;
    background: none;
    border: none;
    padding: 0;
    transition: color .2s ease;
  }
  .ft-links a:hover,
  .ft-cookie:hover {
    color: #FFFFFF;
  }

  @media (max-width: 767px) {
    .ft-inner {
      padding: 56px 20px 32px;
    }
    .ft-top {
      align-items: flex-start;
    }
    .ft-bottom {
      margin-top: 40px;
    }
  }
</style>
