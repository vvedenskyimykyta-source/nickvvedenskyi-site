---
import { t, getLocale } from '../i18n';
import { site } from '../data/site';

const locale = getLocale(Astro.currentLocale);
---

<footer class="bg-dark border-t border-white/10">
  <div class="mx-auto max-w-[1240px] px-4 md:px-8 py-12 md:py-16">
    <div class="flex flex-col gap-8">
      <!-- Top -->
      <div class="flex flex-col gap-4">
        <p class="font-display text-lg font-bold text-white">{site.name} · {t(locale, 'footerTagline')}</p>
        <address class="not-italic flex gap-4 items-center">
          {site.linkedin && (
            <a
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/60 hover:text-green transition-colors touch-manipulation min-w-[44px] min-h-[44px] flex items-center justify-center"
              data-event="outbound_linkedin"
              data-location="footer"
              aria-label="LinkedIn"
            >
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          )}
          {site.email && (
            <a
              href={`mailto:${site.email}`}
              class="text-white/60 hover:text-green transition-colors touch-manipulation min-w-[44px] min-h-[44px] flex items-center justify-center"
              data-event="click_email"
              data-location="footer"
              aria-label="Email"
            >
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
          )}
        </address>
      </div>

      <hr class="border-white/10" />

      <!-- Bottom -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap gap-4 sm:gap-6">
          <a href={locale === 'uk' ? '/uk/privacy' : '/privacy'} class="text-sm text-white/60 hover:text-white transition-colors touch-manipulation min-h-[44px] flex items-center">
            {t(locale, 'footerPrivacy')}
          </a>
          <button
            id="cookie-settings-btn"
            class="text-sm text-white/60 hover:text-white transition-colors touch-manipulation min-h-[44px] flex items-center"
          >
            {t(locale, 'footerCookies')}
          </button>
        </div>
        <p class="text-sm text-white/60">{t(locale, 'footerMade')}</p>
      </div>
    </div>
  </div>
</footer>
