---
import { t, getLocale } from '../i18n';
import { site } from '../data/site';

const locale = getLocale(Astro.currentLocale);
---

<footer class="bg-deep text-white">
  <div class="mx-auto max-w-[1240px] px-4 md:px-8 py-16 md:py-20">
    <!-- Large name -->
    <p class="font-display text-[clamp(2.5rem,6vw,4rem)] font-bold leading-none tracking-[-0.03em]">{site.name}</p>
    <p class="mt-2 text-lg" style="color: #CCE9FF;">{t(locale, 'footerTagline')}</p>

    <!-- Social icons -->
    <div class="mt-8 flex gap-3">
      {site.linkedin && (
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 rounded-xl bg-white/[0.08] flex items-center justify-center text-white/70 hover:bg-white/[0.15] hover:text-white transition-all"
          data-event="outbound_linkedin"
          data-location="footer"
          aria-label="LinkedIn"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      )}
      {site.email && (
        <a
          href={`mailto:${site.email}`}
          class="w-12 h-12 rounded-xl bg-white/[0.08] flex items-center justify-center text-white/70 hover:bg-white/[0.15] hover:text-white transition-all"
          data-event="click_email"
          data-location="footer"
          aria-label="Email"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
      )}
      {site.instagram && (
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 rounded-xl bg-white/[0.08] flex items-center justify-center text-white/70 hover:bg-white/[0.15] hover:text-white transition-all"
          data-event="outbound_instagram"
          data-location="footer"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
        </a>
      )}
    </div>

    <hr class="mt-10 border-white/[0.08]" />

    <!-- Bottom -->
    <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap gap-4 sm:gap-6">
        <a href={locale === 'uk' ? '/uk/privacy' : '/privacy'} class="text-sm text-white/50 hover:text-white transition-colors touch-manipulation min-h-[44px] flex items-center">
          {t(locale, 'footerPrivacy')}
        </a>
        <button
          id="cookie-settings-btn"
          class="text-sm text-white/50 hover:text-white transition-colors touch-manipulation min-h-[44px] flex items-center"
        >
          {t(locale, 'footerCookies')}
        </button>
      </div>
      <p class="text-sm text-white/40">{t(locale, 'footerMade')}</p>
    </div>
  </div>
</footer>
