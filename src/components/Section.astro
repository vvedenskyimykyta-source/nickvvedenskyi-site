---
interface Props {
  id?: string;
  class?: string;
  bg?: 'paper' | 'paper-2' | 'deep';
  narrow?: boolean;
  ariaLabelledby?: string;
}

const { id, class: className = '', bg = 'paper', narrow, ariaLabelledby } = Astro.props;

const bgClasses = {
  paper: 'bg-paper',
  'paper-2': 'bg-paper-2',
  deep: 'bg-deep text-text-on-dark',
}[bg];
---

<section
  id={id}
  aria-labelledby={ariaLabelledby}
  class:list={[
    'relative py-16 md:py-24',
    bgClasses,
    className,
  ]}
  style={id ? 'scroll-margin-top: 5rem;' : undefined}
>
  <div class:list={['mx-auto px-6 md:px-6', narrow ? 'max-w-3xl' : 'max-w-[1280px]']}>
    <slot />
  </div>
</section>
