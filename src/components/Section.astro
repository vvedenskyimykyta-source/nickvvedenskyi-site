---
interface Props {
  id?: string;
  class?: string;
  bg?: 'white' | 'bg' | 'dark';
  narrow?: boolean;
  ariaLabelledby?: string;
}

const { id, class: className = '', bg = 'white', narrow, ariaLabelledby } = Astro.props;

const bgClasses = {
  white: 'bg-white',
  bg: 'bg-bg',
  dark: 'bg-dark text-white',
}[bg];
---

<section
  id={id}
  aria-labelledby={ariaLabelledby}
  class:list={[
    'relative py-[60px] md:py-[100px]',
    bgClasses,
    className,
  ]}
  style={id ? 'scroll-margin-top: 5rem;' : undefined}
>
  <div class:list={['mx-auto px-4 md:px-8', narrow ? 'max-w-3xl' : 'max-w-[1240px]']}>
    <slot />
  </div>
</section>
