---
import 'vanilla-cookieconsent/dist/cookieconsent.css';

const gtmId = import.meta.env.PUBLIC_GTM_ID || '';
---

<!-- Consent Mode v2 defaults — must be FIRST, before any GTM/GA -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    wait_for_update: 500
  });
</script>

<!-- GTM — loaded immediately; Consent Mode controls data collection -->
{gtmId && (
  <script is:inline define:vars={{ gtmId }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',gtmId);
  </script>
)}

<!-- UTM session persistence + dataLayer event listener + Cookie consent (bundled by Vite) -->
<script>
  // UTM persistence
  const params = new URLSearchParams(window.location.search);
  const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'] as const;
  for (const key of utmKeys) {
    const v = params.get(key);
    if (v) {
      try { sessionStorage.setItem(key, v); } catch {}
    }
  }

  // Remember where the visit came from, once. Later page views inside the site
  // would otherwise overwrite it with our own hostname.
  try {
    if (!sessionStorage.getItem('referrer')) {
      const ref = document.referrer;
      const external = ref && new URL(ref).hostname !== location.hostname;
      sessionStorage.setItem('referrer', external ? new URL(ref).hostname : 'direct');
    }
  } catch {}

  // Remember which section sent someone toward the booking area, so a journey
  // that starts at the pipeline and ends on the final CTA is not just "final".
  document.addEventListener('click', (e) => {
    const anchor = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href="#book"][data-location]');
    if (anchor?.dataset.location) {
      try { sessionStorage.setItem('cta_origin', anchor.dataset.location); } catch {}
    }
  }, true);

  // Tally and Cal only ever see what the link hands them, so attribution has to
  // ride in the query string. Built at click time, in capture, before navigation.
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>(
      'a[href*="tally.so/r/"], a[href*="cal.com/"]'
    );
    if (!link) return;
    try {
      const url = new URL(link.href);
      for (const key of utmKeys) {
        const v = params.get(key) || sessionStorage.getItem(key);
        if (v && !url.searchParams.has(key)) url.searchParams.set(key, v);
      }
      if (!url.searchParams.has('referrer')) {
        url.searchParams.set('referrer', sessionStorage.getItem('referrer') || 'direct');
      }
      url.searchParams.set('source_page', location.pathname);
      url.searchParams.set('lang', document.documentElement.lang || 'en');

      // Which button converted: where they landed, and where they set off from.
      const here = link.dataset.location || '';
      let origin = '';
      try { origin = sessionStorage.getItem('cta_origin') || ''; } catch {}
      const cta = origin && origin !== here ? `${origin}->${here}` : here;
      if (cta) url.searchParams.set('cta_location', cta);

      link.href = url.toString();
    } catch {}
  }, true);

  // dataLayer event listener for data-event attributes
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-event]');
    if (!el) return;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: el.dataset.event,
      event_location: el.dataset.location || '',
      lang: document.documentElement.lang || 'en',
    });
  });

  // Cookie consent
  import('vanilla-cookieconsent').then((mod) => {
    const cc = mod.default || mod;
    if (typeof cc.run !== 'function') return;

    const locale = document.documentElement.lang === 'uk' ? 'uk' : 'en';
    const texts = locale === 'uk' ? {
      desc: 'Я використовую аналітичні cookies, щоб розуміти, які частини сайту корисні, а які ні. Нічого не продається і нічого підозрілого не відбувається. Можеш відмовитись, і все одно все працюватиме.',
      accept: 'Прийняти аналітику',
      decline: 'Ні, дякую',
      settings: 'Налаштування',
      mTitle: 'Налаштування cookie',
      necessary: 'Необхідні',
      necessaryDesc: 'Cookie, який запам\'ятовує твій вибір щодо cookies.',
      analytics: 'Аналітика',
      analyticsDesc: 'Допомагають мені зрозуміти, як люди використовують сайт. Жодних рекламних cookies.',
      save: 'Зберегти',
      acceptAll: 'Прийняти все',
      rejectAll: 'Відхилити все',
    } : {
      desc: 'I use analytics cookies to see which parts of this site are useful and which are not. Nothing is sold and nothing creepy happens. You can say no and everything still works.',
      accept: 'Accept analytics',
      decline: 'No thanks',
      settings: 'Settings',
      mTitle: 'Cookie settings',
      necessary: 'Necessary',
      necessaryDesc: 'The cookie that remembers your cookie consent choice.',
      analytics: 'Analytics',
      analyticsDesc: 'Help me understand how people use the site. No advertising cookies.',
      save: 'Save settings',
      acceptAll: 'Accept all',
      rejectAll: 'Reject all',
    };

    function updateConsent(accepted: boolean) {
      // Consent Mode reads the arguments object that gtag() pushes. A plain array
      // lands in the dataLayer as an ordinary message and GTM ignores it, which
      // leaves analytics denied however many times the visitor accepts.
      (window as any).gtag?.('consent', 'update', {
        analytics_storage: accepted ? 'granted' : 'denied',
      });
    }

    cc.run({
      guiOptions: {
        consentModal: { layout: 'bar', position: 'bottom', equalWeightButtons: false },
        preferencesModal: { layout: 'box' },
      },
      categories: {
        necessary: { enabled: true, readOnly: true },
        analytics: { enabled: false },
      },
      language: {
        default: locale,
        translations: {
          [locale]: {
            consentModal: {
              description: texts.desc,
              acceptAllBtn: texts.accept,
              acceptNecessaryBtn: texts.decline,
              showPreferencesBtn: texts.settings,
            },
            preferencesModal: {
              title: texts.mTitle,
              savePreferencesBtn: texts.save,
              acceptAllBtn: texts.acceptAll,
              acceptNecessaryBtn: texts.rejectAll,
              sections: [
                { title: texts.necessary, description: texts.necessaryDesc, linkedCategory: 'necessary' },
                { title: texts.analytics, description: texts.analyticsDesc, linkedCategory: 'analytics' },
              ],
            },
          },
        },
      },
      onFirstConsent: ({ cookie }) => {
        updateConsent(cookie.categories.includes('analytics'));
      },
      onChange: ({ cookie }) => {
        updateConsent(cookie.categories.includes('analytics'));
      },
      onConsent: ({ cookie }) => {
        if (cookie.categories.includes('analytics')) updateConsent(true);
      },
    });

    document.getElementById('cookie-settings-btn')?.addEventListener('click', () => {
      cc.showPreferences();
    });
  });
</script>
