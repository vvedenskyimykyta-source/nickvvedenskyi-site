---
/**
 * Hand-drawn inline SVG doodles in --wine.
 * Use: <Doodles type="burst" /> or <Doodles type="underline" /> etc.
 */
interface Props {
  type: 'burst' | 'underline' | 'arrow-curved' | 'star' | 'circle';
  class?: string;
}

const { type, class: className = '' } = Astro.props;
---

{type === 'burst' && (
  <svg class:list={['inline-block', className]} width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M14 2 L16 12 L26 14 L16 16 L14 26 L12 16 L2 14 L12 12 Z" stroke="var(--color-green)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M6 6 L10 10" stroke="var(--color-green)" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M22 6 L18 10" stroke="var(--color-green)" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M6 22 L10 18" stroke="var(--color-green)" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M22 22 L18 18" stroke="var(--color-green)" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
)}

{type === 'underline' && (
  <svg class:list={['block', className]} width="100%" height="12" viewBox="0 0 200 12" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 8 C40 2, 80 10, 120 6 C160 2, 190 8, 198 4" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  </svg>
)}

{type === 'arrow-curved' && (
  <svg class:list={['inline-block', className]} width="48" height="36" viewBox="0 0 48 36" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 4 C12 2, 28 2, 36 12 C44 22, 40 32, 32 32" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" fill="none"/>
    <path d="M36 28 L32 32 L36 36" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  </svg>
)}

{type === 'star' && (
  <svg class:list={['inline-block', className]} width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M10 1 L12 8 L19 10 L12 12 L10 19 L8 12 L1 10 L8 8 Z" stroke="var(--color-green)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{type === 'circle' && (
  <svg class:list={['inline-block', className]} width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 3 C18 3, 21 7, 21 12 C21 17, 17 21, 12 21 C7 21, 3 17, 3 12 C3 7, 7 3, 12 3 Z" stroke="var(--color-green)" stroke-width="1.5" fill="none" stroke-linecap="round"/>
  </svg>
)}
