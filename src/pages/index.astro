---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Numbers from '../components/sections/Numbers.astro';
import QuoteBand from '../components/sections/QuoteBand.astro';
import Problems from '../components/sections/Problems.astro';
import Divider from '../components/sections/Divider.astro';
import Pipeline from '../components/sections/Pipeline.astro';
import FoundingBanner from '../components/sections/FoundingBanner.astro';
import Cases from '../components/sections/Cases.astro';
import About from '../components/sections/About.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import HowIWork from '../components/sections/HowIWork.astro';
import Projects from '../components/sections/Projects.astro';
import FAQ from '../components/sections/FAQ.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { t, getLocale } from '../i18n';

const locale = getLocale(Astro.currentLocale);
---

<Layout
  title="Nick Vvedenskyi · Revenue & Marketing for Tech/AI Products"
  description="I help tech and AI founders figure out who buys, why they stay and where the money is hiding. Customer discovery, positioning, retention and go-to-market sprints. Based in Spain, working in English and Ukrainian."
  showFaqSchema
>
  <Hero />
  <Numbers />
  <QuoteBand />
  <Problems />
  <Divider text={t(locale, 'pipelineDivider')} />
  <Pipeline />
  <FoundingBanner />
  <Cases />
  <About />
  <Testimonials />
  <HowIWork />
  <Projects />
  <FAQ />
  <FinalCTA />
</Layout>
